e([\n    transforms.Resize((224, 224)), transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5), transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(), transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, lbl, dom = self.data[idx]\n        try:\n            img = Image.open(path).convert('RGB')\n            if self.transform: img = self.transform(img)\n        except Exception:\n            img = torch.zeros(3, 224, 224) # ভাঙা ছবি হলে কালো ছবি দিবে\n        return img, int(lbl), int(dom)\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle: random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self): return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\ntrain_loader = DataLoader(CCMTDataset(train_data, train_tf), batch_sampler=DomainBatchSampler(train_data, BATCH_SIZE, True), num_workers=2, pin_memory=True)\nval_loader = DataLoader(CCMTDataset(val_data, val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# ============================================================\n# ৩. Model Architecture (CrossMambaAgriV2)\n# ============================================================\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# ৪. Loss & Train Functions\n# ============================================================\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__(); self.alpha = alpha; self.gamma = gamma; self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction='none', label_smoothing=self.ls)\n        pt = torch.exp(-ce); return (((1 - pt) ** self.gamma) * ce).mean()\n\ndef train_one_epoch(model, loader, optimizer, cd, cp, desc=\"Train\"):\n    model.train(); tl, co, to, v = 0.0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=desc):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        optimizer.zero_grad()\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1); loss = torch.tensor(0.0, device=device)\n        if dm.any(): loss += cd(ld[dm], labels[dm]); co += (ld[dm].argmax(1) == labels[dm]).sum().item(); to += dm.sum().item()\n        if pm.any(): loss += cp(lp[pm], labels[pm]); co += (lp[pm].argmax(1) == labels[pm]).sum().item(); to += pm.sum().item()\n        if torch.isnan(loss) or torch.isinf(loss): continue\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n        tl += loss.item(); v += 1\n    return tl/max(1,v), 100*co/max(1,to)\n\n@torch.no_grad()\ndef evaluate(model, loader, cd, cp):\n    model.eval(); co, to = 0, 0; dc, dt, pc, pt = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any(): a = ld[dm]; b = labels[dm]; dc += (a.argmax(1) == b).sum().item(); dt += b.size(0)\n        if pm.any(): a = lp[pm]; b = labels[pm]; pc += (a.argmax(1) == b).sum().item(); pt += b.size(0)\n        to += labels.size(0)\n    return 100*(dc+pc)/to, 100*dc/max(1,dt), 100*pc/max(1,pt)\n\n# ============================================================\n# ৫. Training Loop (30 Epochs)\n# ============================================================\nmodel = CrossMambaAgriV2(dis_cls=17, pest_cls=5).to(device)\n# ডামি ক্লাস ওয়েট (সব 1.0)\nleaked_dis_w = torch.ones(17).to(device); leaked_pest_w = torch.ones(5).to(device)\ncrit_dis = FocalLoss(alpha=leaked_dis_w, gamma=2.0).to(device); crit_pest = FocalLoss(alpha=leaked_pest_w, gamma=2.0).to(device)\n\nEPOCHS = 30 \noptimizer = optim.AdamW(model.parameters(), lr=5e-5, weight_decay=0.05)\nscheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n\nbest_val = 0; patience = 7; no_improve = 0\n\nprint(f\"\\n{'='*50}\\nStarting CrossMamba Training on HONEST Clean Split\\n{'='*50}\")\nfor epoch in range(EPOCHS):\n    train_loss, train_acc = train_one_epoch(model, train_loader, optimizer, crit_dis, crit_pest, desc=f\"Ep{epoch+1}\")\n    val_acc, dis_acc, pest_acc = evaluate(model, val_loader, crit_dis, crit_pest)\n    scheduler.step()\n    \n    print(f\"\\n[Ep {epoch+1}/{EPOCHS}] Train: {train_acc:.2f}% | Val: {val_acc:.2f}% (Dis: {dis_acc:.2f}% | Pest: {pest_acc:.2f}%)\")\n    \n    if val_acc > best_val:\n        best_val = val_acc; no_improve = 0\n        torch.save(model.state_dict(), '/kaggle/working/model_honest_best.pth')\n        print(f\" 💾 Saved New Best! (Val: {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\" ⏸️ No improvement ({no_improve}/{patience})\")\n        if no_improve >= patience:\n            print(f\"🛑 Early stopping triggered.\")\n            break\n\nprint(f\"\\n✅ Training Complete. Best Val Acc: {best_val:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T17:03:29.24587Z","iopub.execute_input":"2026-11-08T17:03:29.246449Z","iopub.status.idle":"2026-11-08T17:35:21.753206Z","shell.execute_reply.started":"2026-11-08T17:03:29.246416Z","shell.execute_reply":"2026-11-08T17:35:21.752102Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\n📊 Loading Clean Splits...\n✅ Train: 84235, Val: 10477\n\n==================================================\nStarting CrossMamba Training on HONEST Clean Split\n==================================================\n","output_type":"stream"},{"name":"stderr","text":"Ep1:  68%|██████▊   | 7201/10530 [31:51<14:43,  3.77it/s]  \n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_294/2182695220.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    195\u001b[0m \