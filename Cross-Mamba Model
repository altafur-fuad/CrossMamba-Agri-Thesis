{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":20725223},{"sourceType":"datasetVersion","sourceId":20815687},{"sourceType":"datasetVersion","sourceId":21183757},{"sourceType":"datasetVersion","sourceId":21275419},{"sourceType":"datasetVersion","sourceId":21276797},{"sourceType":"datasetVersion","sourceId":21277150}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================\n# CELL 1: Install mamba-ssm + Verify (via subprocess)\n# ============================================================\n# SAFE to run multiple times:\n#   1st run:  installs mamba-ssm → verifies\n#   After Restart: install skipped → verifies again\n#\n# Uses subprocess so torch._prims conflict doesn't happen.\n\nimport subprocess\nimport sys\nimport os\n\nprint(\"=\"*70)\nprint(\"  STEP 1: Install mamba-ssm + causal-conv1d\")\nprint(\"=\"*70)\n\n!pip install causal-conv1d --no-build-isolation -q\n!pip install mamba-ssm --no-build-isolation -q\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  STEP 2: Verify Environment\")\nprint(\"=\"*70)\n\n# Fresh subprocess verification\nverify_script = \"\"\"\nimport sys\ntry:\n    import torch\n    print(f\"VERIFY_TORCH_OK:{torch.__version__}\")\n    print(f\"VERIFY_CUDA:{torch.cuda.is_available()}\")\n    if torch.cuda.is_available():\n        print(f\"VERIFY_GPU:{torch.cuda.get_device_name(0)}\")\nexcept Exception as e:\n    print(f\"VERIFY_TORCH_FAIL:{e}\"); sys.exit(1)\n\ntry:\n    from mamba_ssm import Mamba\n    print(f\"VERIFY_MAMBA_OK\")\nexcept Exception as e:\n    print(f\"VERIFY_MAMBA_FAIL:{e}\"); sys.exit(1)\n\ntry:\n    m = Mamba(d_model=64, d_state=16, d_conv=4, expand=2).cuda()\n    y = m(torch.randn(2, 196, 64).cuda())\n    print(f\"VERIFY_FORWARD_OK:{tuple(y.shape)}\")\nexcept Exception as e:\n    print(f\"VERIFY_FORWARD_FAIL:{e}\"); sys.exit(1)\n\nprint(\"VERIFY_ALL_SUCCESS\")\n\"\"\"\n\nresult = subprocess.run(\n    [sys.executable, \"-c\", verify_script],\n    capture_output=True, text=True, timeout=300\n)\n\n# Parse\nprint(\"\\n📋 Verification output:\")\nprint(\"-\" * 70)\nfor line in result.stdout.strip().split(\"\\n\"):\n    if line.startswith(\"VERIFY_TORCH_OK:\"):\n        print(f\"✅ torch:       {line.split(':',1)[1]}\")\n    elif line.startswith(\"VERIFY_CUDA:\"):\n        print(f\"✅ CUDA:        {line.split(':',1)[1]}\")\n    elif line.startswith(\"VERIFY_GPU:\"):\n        print(f\"✅ GPU:         {line.split(':',1)[1]}\")\n    elif line.startswith(\"VERIFY_MAMBA_OK\"):\n        print(f\"✅ mamba_ssm:   Imported OK\")\n    elif line.startswith(\"VERIFY_FORWARD_OK:\"):\n        print(f\"✅ Forward:     Output {line.split(':',1)[1]}\")\n    elif line.startswith(\"VERIFY_ALL_SUCCESS\"):\n        print(f\"✅ All:         SUCCESS\")\n    elif line.startswith(\"VERIFY_\"):\n        print(f\"❌ {line}\")\n\nprint(\"\\n\" + \"=\"*70)\nif \"VERIFY_ALL_SUCCESS\" in result.stdout:\n    print(\"  ✅ CELL 1 SUCCESS\")\n    print(\"=\"*70)\n    print(\"\\n⚠️  NEXT STEP:\")\n    print(\"     Run → Restart & Clear Cell Outputs\")\n    print(\"\\n   After Restart:\")\n    print(\"     → Run this SAME CELL 1 again (fast, install skipped)\")\n    print(\"     → Then say: 'Cell 2 dao'\")\nelse:\n    print(\"  ❌ VERIFICATION FAILED\")\n    print(\"=\"*70)\n    if result.stderr:\n        print(result.stderr[-2000:])","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 2: Dataset Structure Check (Updated)\n# ============================================================\nimport os\nfrom collections import Counter\n\nprint(\"=\"*70)\nprint(\"  DATASET STRUCTURE CHECK\")\nprint(\"=\"*70)\n\n# ============================================================\n# 1. RAW DATASET — try multiple paths\n# ============================================================\nprint(\"\\n[1] RAW CCMT DATASET\")\nprint(\"-\"*70)\n\nRAW_CANDIDATES = [\n    '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset',\n    '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/CCMT Dataset',\n    ('/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/'\n     'Dataset for Crop Pest and Disease Detection/'\n     'Dataset for Crop Pest and Disease Detection/'\n     'Raw Data/CCMT Dataset'),\n]\n\nRAW_ROOT = None\nfor p in RAW_CANDIDATES:\n    if os.path.exists(p):\n        RAW_ROOT = p\n        print(f\"✅ Found: {p}\")\n        break\n\nif RAW_ROOT is None:\n    # Fallback: search\n    for dp, dn, fn in os.walk('/kaggle/input'):\n        if os.path.basename(dp) == 'CCMT Dataset' and 'Augmented' not in dp:\n            # Verify it has crop subfolders\n            subdirs = [d for d in os.listdir(dp) if os.path.isdir(os.path.join(dp, d))]\n            if 'Cashew' in subdirs and 'Cassava' in subdirs:\n                RAW_ROOT = dp\n                print(f\"✅ Found via search: {p}\")\n                break\n\nprint(f\"\\nRAW_ROOT: {RAW_ROOT}\")\n\nraw_class_counts = {}\nraw_total = 0\nfor crop in sorted(os.listdir(RAW_ROOT)):\n    crop_path = os.path.join(RAW_ROOT, crop)\n    if not os.path.isdir(crop_path): continue\n    print(f\"\\n📁 {crop}/\")\n    for cls in sorted(os.listdir(crop_path)):\n        cls_path = os.path.join(crop_path, cls)\n        if not os.path.isdir(cls_path): continue\n        n = sum(1 for f in os.listdir(cls_path)\n                if f.lower().endswith(('.jpg','.jpeg','.png')))\n        raw_class_counts[f\"{crop}/{cls}\"] = n\n        raw_total += n\n        print(f\"   {cls:30s} : {n:5d}\")\n\nprint(f\"\\n✅ RAW Total: {raw_total} images, {len(raw_class_counts)} classes\")\n\n\n# ============================================================\n# 2. AUGMENTED DATASET — try multiple paths\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  [2] AUGMENTED CCMT DATASET\")\nprint(\"-\"*70)\n\nAUG_CANDIDATES = [\n    '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented',\n    '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented/CCMT Dataset-Augmented',\n]\n\nAUG_ROOT = None\nfor p in AUG_CANDIDATES:\n    if os.path.exists(p):\n        AUG_ROOT = p\n        print(f\"✅ Found: {p}\")\n        break\n\nif AUG_ROOT is None:\n    for dp, dn, fn in os.walk('/kaggle/input'):\n        if 'CCMT Dataset-Augmented' in os.path.basename(dp):\n            # Verify it contains crop subfolders with train_set/test_set\n            subdirs = [d for d in os.listdir(dp) if os.path.isdir(os.path.join(dp, d))]\n            if 'Cashew' in subdirs and 'Cassava' in subdirs:\n                AUG_ROOT = dp\n                print(f\"✅ Found via search: {dp}\")\n                break\n\nprint(f\"\\nAUG_ROOT: {AUG_ROOT}\")\n\naug_total = 0\nfor crop in sorted(os.listdir(AUG_ROOT)):\n    crop_path = os.path.join(AUG_ROOT, crop)\n    if not os.path.isdir(crop_path): continue\n    print(f\"\\n📁 {crop}/\")\n    for split in sorted(os.listdir(crop_path)):\n        split_path = os.path.join(crop_path, split)\n        if not os.path.isdir(split_path): continue\n        n_classes = 0\n        n_imgs = 0\n        for cls in sorted(os.listdir(split_path)):\n            cls_path = os.path.join(split_path, cls)\n            if not os.path.isdir(cls_path): continue\n            n_classes += 1\n            n_imgs += sum(1 for f in os.listdir(cls_path)\n                          if f.lower().endswith(('.jpg','.jpeg','.png')))\n        print(f\"   {split:15s}: {n_classes:2d} classes, {n_imgs:6d} images\")\n        aug_total += n_imgs\n\nprint(f\"\\n✅ AUGMENTED Total: {aug_total} images\")\n\n\n# ============================================================\n# 3. SAVE RESOLVED PATHS (for later cells)\n# ============================================================\nimport json\npaths_data = {\n    'RAW_ROOT': RAW_ROOT,\n    'AUG_ROOT': AUG_ROOT,\n}\nwith open('/kaggle/working/resolved_paths.json', 'w') as f:\n    json.dump(paths_data, f, indent=2)\nprint(f\"\\n✅ Saved resolved paths: resolved_paths.json\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  ✅ CELL 2 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 3: RAW CCMT Cleaning + Split\n# ============================================================\n# Steps:\n#   1. Collect all raw image paths (22 classes)\n#   2. Corrupt image check (PIL verify)\n#   3. pHash deduplication (Hamming < 6)\n#   4. 80/10/10 per-class stratified split\n#   5. Save raw_clean_split.json\n\nimport os, json, time, random\nfrom collections import defaultdict, Counter\nfrom PIL import Image\nimport imagehash\nfrom tqdm import tqdm\n\nSEED = 42\nrandom.seed(SEED)\n\n# Load resolved paths\nwith open('/kaggle/working/resolved_paths.json') as f:\n    paths = json.load(f)\nRAW_ROOT = paths['RAW_ROOT']\n\nprint(\"=\"*70)\nprint(\"  RAW CCMT CLEANING PIPELINE\")\nprint(\"=\"*70)\nprint(f\"RAW_ROOT: {RAW_ROOT}\")\n\n# ============================================================\n# 1. Collect all raw image paths\n# ============================================================\nclass_to_images = defaultdict(list)\nfor crop in sorted(os.listdir(RAW_ROOT)):\n    crop_path = os.path.join(RAW_ROOT, crop)\n    if not os.path.isdir(crop_path): continue\n    for cls in sorted(os.listdir(crop_path)):\n        cls_path = os.path.join(crop_path, cls)\n        if not os.path.isdir(cls_path): continue\n        key = f\"{crop}/{cls}\"\n        for f in os.listdir(cls_path):\n            if f.lower().endswith(('.jpg','.jpeg','.png')):\n                class_to_images[key].append(os.path.join(cls_path, f))\n\nall_classes = sorted(class_to_images.keys())\nclass_to_idx = {c: i for i, c in enumerate(all_classes)}\nidx_to_class = {i: c for c, i in class_to_idx.items()}\n\nPEST_KEYWORDS = ['leaf miner', 'green mite', 'fall armyworm',\n                 'grasshoper', 'leaf beetle']\ndef get_domain(cls_name):\n    return 1 if any(kw in cls_name.lower() for kw in PEST_KEYWORDS) else 0\n\nclass_to_domain = {c: get_domain(c) for c in all_classes}\n\ntotal_images = sum(len(v) for v in class_to_images.values())\nprint(f\"\\n✅ Total classes: {len(class_to_images)}\")\nprint(f\"✅ Total images:  {total_images}\")\n\n\n# ============================================================\n# 2. Corrupt image check\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  [1] CORRUPT IMAGE CHECK\")\nprint(\"=\"*70)\n\nall_paths = []\nfor paths_list in class_to_images.values():\n    all_paths.extend(paths_list)\n\nt0 = time.time()\ncorrupt = []\nfor p in tqdm(all_paths, desc=\"Checking\"):\n    try:\n        with Image.open(p) as img:\n            img.verify()\n        with Image.open(p) as img:\n            _ = img.convert('RGB').size\n    except Exception:\n        corrupt.append(p)\n\ncorrupt_set = set(corrupt)\nprint(f\"\\n✅ Corrupt: {len(corrupt)} / {len(all_paths)}  ({time.time()-t0:.1f}s)\")\n\n\n# ============================================================\n# 3. pHash deduplication\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  [2] PHASH DEDUPLICATION\")\nprint(\"=\"*70)\n\nvalid_paths = [p for p in all_paths if p not in corrupt_set]\n\nt0 = time.time()\nhashes = {}\nfor p in tqdm(valid_paths, desc=\"Hashing\"):\n    try:\n        with Image.open(p) as img:\n            hashes[p] = str(imagehash.phash(img.convert('RGB'), hash_size=8))\n    except Exception:\n        pass\n\nprint(f\"✅ Hashed: {len(hashes)}  ({time.time()-t0:.1f}s)\")\n\n# Union-Find bucketed duplicate detection\nhash_ints = {p: int(h, 16) for p, h in hashes.items()}\npaths_list = list(hash_ints.keys())\nn = len(paths_list)\n\nparent = list(range(n))\ndef find(x):\n    while parent[x] != x:\n        parent[x] = parent[parent[x]]\n        x = parent[x]\n    return x\ndef union(a, b):\n    ra, rb = find(a), find(b)\n    if ra != rb: parent[ra] = rb\n\nmasks = [0xFFFF << 48, 0xFFFF << 32, 0xFFFF << 16, 0xFFFF]\nbuckets = [defaultdict(list) for _ in masks]\nfor i, p in enumerate(paths_list):\n    h = hash_ints[p]\n    for b, mask in enumerate(masks):\n        buckets[b][h & mask].append(i)\n\nthreshold = 6\nfor bucket in buckets:\n    for members in bucket.values():\n        if len(members) < 2: continue\n        for i_idx in range(len(members)):\n            for j_idx in range(i_idx + 1, len(members)):\n                i, j = members[i_idx], members[j_idx]\n                if find(i) == find(j): continue\n                xor = hash_ints[paths_list[i]] ^ hash_ints[paths_list[j]]\n                if bin(xor).count('1') <= threshold:\n                    union(i, j)\n\ngroups = defaultdict(list)\nfor i in range(n):\n    groups[find(i)].append(paths_list[i])\n\ndup_groups = [g for g in groups.values() if len(g) > 1]\nto_remove = []\nfor g in dup_groups:\n    to_remove.extend(g[1:])\n\ndup_set = set(to_remove)\nprint(f\"✅ Duplicate groups: {len(dup_groups)}\")\nprint(f\"✅ Duplicates to remove: {len(dup_set)}\")\n\n\n# ============================================================\n# 4. Rebuild clean class_to_images\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  [3] REBUILD CLEAN CLASS DISTRIBUTION\")\nprint(\"=\"*70)\n\nremove_set = corrupt_set | dup_set\nclean_class_to_images = defaultdict(list)\nfor cls, paths_list_cls in class_to_images.items():\n    for p in paths_list_cls:\n        if p not in remove_set:\n            clean_class_to_images[cls].append(p)\n\nclean_total = sum(len(v) for v in clean_class_to_images.values())\nprint(f\"✅ Clean total: {clean_total}\")\nprint(f\"   Removed: {total_images - clean_total} ({(total_images - clean_total)/total_images*100:.2f}%)\")\n\n\n# ============================================================\n# 5. 80/10/10 per-class split\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  [4] SPLIT (80/10/10 per class)\")\nprint(\"=\"*70)\n\ntrain_data, val_data, test_data = [], [], []\n\nfor cls, paths_list_cls in clean_class_to_images.items():\n    paths_list_cls = list(paths_list_cls)\n    random.shuffle(paths_list_cls)\n    n_cls = len(paths_list_cls)\n    n_train = int(0.8 * n_cls)\n    n_val = int(0.1 * n_cls)\n\n    lbl = class_to_idx[cls]\n    dom = class_to_domain[cls]\n\n    for p in paths_list_cls[:n_train]:\n        train_data.append((p, lbl, dom))\n    for p in paths_list_cls[n_train:n_train+n_val]:\n        val_data.append((p, lbl, dom))\n    for p in paths_list_cls[n_train+n_val:]:\n        test_data.append((p, lbl, dom))\n\nprint(f\"✅ Train: {len(train_data)}\")\nprint(f\"✅ Val:   {len(val_data)}\")\nprint(f\"✅ Test:  {len(test_data)}\")\nprint(f\"✅ Total: {len(train_data) + len(val_data) + len(test_data)}\")\n\n\n# ============================================================\n# 6. Save\n# ============================================================\nraw_clean_data = {\n    'train': train_data,\n    'val': val_data,\n    'test': test_data,\n    'class_to_idx': class_to_idx,\n    'class_to_domain': class_to_domain,\n    'corrupt': list(corrupt_set),\n    'duplicates': list(dup_set),\n    'stats': {\n        'original_total': total_images,\n        'corrupt_count': len(corrupt_set),\n        'duplicate_count': len(dup_set),\n        'clean_total': clean_total,\n    }\n}\n\nwith open('/kaggle/working/raw_clean_split.json', 'w') as f:\n    json.dump(raw_clean_data, f)\n\nprint(\"\\n✅ Saved: raw_clean_split.json\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  SUMMARY\")\nprint(\"=\"*70)\nprint(f\"  Original:       {total_images}\")\nprint(f\"  Corrupt:        {len(corrupt_set)}\")\nprint(f\"  Duplicates:     {len(dup_set)}\")\nprint(f\"  Clean:          {clean_total}\")\nprint(f\"  Train/Val/Test: {len(train_data)}/{len(val_data)}/{len(test_data)}\")\nprint(f\"  Classes:        {len(class_to_idx)}\")\nprint(\"=\"*70)\nprint(\"  ✅ CELL 3 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 4: Augmented Data Load + Folder Normalization\n# ============================================================\n# Fixes Kaggle folder naming bug:\n#   \"gumosis1714\"          → \"gumosis\"\n#   \"bacterial blight3241\" → \"bacterial blight\" (merged)\n#\n# Output: aug_data.json\n\nimport os, json, re\nfrom collections import defaultdict\n\nprint(\"=\"*70)\nprint(\"  AUGMENTED DATA LOAD + NORMALIZATION\")\nprint(\"=\"*70)\n\n# Load resolved paths\nwith open('/kaggle/working/resolved_paths.json') as f:\n    paths = json.load(f)\nAUG_ROOT = paths['AUG_ROOT']\n\n# Load raw mappings\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\n\nclass_to_idx = raw_data['class_to_idx']\nclass_to_domain = raw_data['class_to_domain']\n\nprint(f\"AUG_ROOT: {AUG_ROOT}\")\nprint(f\"✅ Loaded raw mappings: {len(class_to_idx)} classes\")\n\n\n# ============================================================\n# Folder name normalizer\n# ============================================================\ndef normalize_name(name):\n    \"\"\"Remove trailing digits: 'gumosis1714' → 'gumosis'\"\"\"\n    return re.sub(r'\\s*\\d+\\s*$', '', name).strip()\n\n\n# ============================================================\n# Walk augmented structure\n# ============================================================\naug_train = []\naug_test  = []\n\naug_class_counts = {\n    'train': defaultdict(int),\n    'test':  defaultdict(int),\n}\n\nunmatched = []\n\nfor crop in sorted(os.listdir(AUG_ROOT)):\n    crop_path = os.path.join(AUG_ROOT, crop)\n    if not os.path.isdir(crop_path): continue\n    print(f\"\\n📁 {crop}/\")\n\n    for split in ['train_set', 'test_set']:\n        split_path = os.path.join(crop_path, split)\n        if not os.path.exists(split_path): continue\n\n        for cls_folder in sorted(os.listdir(split_path)):\n            cls_path = os.path.join(split_path, cls_folder)\n            if not os.path.isdir(cls_path): continue\n\n            # Normalize\n            norm_name = normalize_name(cls_folder)\n            full_class_name = f\"{crop}/{norm_name}\"\n\n            # Match to raw class (case-insensitive)\n            matched_class = None\n            if full_class_name in class_to_idx:\n                matched_class = full_class_name\n            else:\n                for rc in class_to_idx.keys():\n                    if rc.lower() == full_class_name.lower():\n                        matched_class = rc\n                        break\n\n            if matched_class is None:\n                unmatched.append(f\"{crop}/{split}/{cls_folder}\")\n                continue\n\n            lbl = class_to_idx[matched_class]\n            dom = class_to_domain[matched_class]\n\n            n_imgs = 0\n            for f in os.listdir(cls_path):\n                if f.lower().endswith(('.jpg','.jpeg','.png')):\n                    path = os.path.join(cls_path, f)\n                    if split == 'train_set':\n                        aug_train.append((path, lbl, dom))\n                    else:\n                        aug_test.append((path, lbl, dom))\n                    n_imgs += 1\n\n            aug_class_counts[split.replace('_set','')][matched_class] += n_imgs\n            print(f\"   [{split:9s}] {cls_folder:30s} → {matched_class:35s} ({n_imgs:5d})\")\n\n\n# ============================================================\n# Summary\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  AUGMENTED SUMMARY\")\nprint(\"=\"*70)\nprint(f\"  Train: {len(aug_train)} images\")\nprint(f\"  Test:  {len(aug_test)} images\")\nprint(f\"  Total: {len(aug_train) + len(aug_test)} images\")\n\nif unmatched:\n    print(f\"\\n⚠️ Unmatched folders: {len(unmatched)}\")\n    for u in unmatched[:10]:\n        print(f\"   {u}\")\n\n\n# ============================================================\n# Save\n# ============================================================\naug_data = {\n    'train': aug_train,\n    'test':  aug_test,\n    'class_to_idx': class_to_idx,\n    'class_to_domain': class_to_domain,\n    'class_counts': {\n        'train': dict(aug_class_counts['train']),\n        'test':  dict(aug_class_counts['test']),\n    },\n    'unmatched_folders': unmatched,\n}\n\nwith open('/kaggle/working/aug_data.json', 'w') as f:\n    json.dump(aug_data, f)\n\nprint(\"\\n✅ Saved: aug_data.json\")\nprint(\"=\"*70)\nprint(\"  ✅ CELL 4 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 5: Leakage Analysis — Karthik's Augmented Split\n# ============================================================\n# Purpose: Quantify how many test images share parent with \n# train images (data leakage).\n#\n# Method:\n#   1. Sample 8,000 train + 5,000 test images\n#   2. Compute pHash for both\n#   3. Cross-match (Hamming < 8)\n#   4. Compute leakage rate\n\nimport os, json, time\nfrom collections import defaultdict\nfrom PIL import Image\nimport imagehash\nfrom tqdm import tqdm\nimport random\n\nprint(\"=\"*70)\nprint(\"  LEAKAGE ANALYSIS — Karthik's Augmented Split\")\nprint(\"=\"*70)\n\n# Load augmented data\nwith open('/kaggle/working/aug_data.json') as f:\n    aug_data = json.load(f)\n\naug_train = aug_data['train']\naug_test  = aug_data['test']\n\nprint(f\"\\n✅ Loaded augmented data:\")\nprint(f\"   Train: {len(aug_train)}\")\nprint(f\"   Test:  {len(aug_test)}\")\n\n# ============================================================\n# Sample filenames for inspection\n# ============================================================\nrandom.seed(42)\nprint(\"\\n\" + \"=\"*70)\nprint(\"  SAMPLE FILENAMES\")\nprint(\"=\"*70)\nprint(\"\\n📄 Train samples:\")\nfor path, lbl, dom in random.sample(aug_train, 5):\n    print(f\"   {os.path.basename(path)}\")\nprint(\"\\n📄 Test samples:\")\nfor path, lbl, dom in random.sample(aug_test, 5):\n    print(f\"   {os.path.basename(path)}\")\n\n# ============================================================\n# Compute pHash — Sample for speed\n# ============================================================\nTRAIN_SAMPLE = min(8000, len(aug_train))\nTEST_SAMPLE  = min(5000, len(aug_test))\n\nrandom.seed(42)\ntrain_sample = random.sample(aug_train, TRAIN_SAMPLE)\ntest_sample  = random.sample(aug_test,  TEST_SAMPLE)\n\nprint(f\"\\nSampled {TRAIN_SAMPLE} train + {TEST_SAMPLE} test\")\nprint(\"Computing pHash...\")\n\nt0 = time.time()\ntrain_hashes = {}\nfor p, lbl, dom in tqdm(train_sample, desc=\"Train hashes\"):\n    try:\n        with Image.open(p) as img:\n            train_hashes[p] = str(imagehash.phash(img.convert('RGB'), hash_size=8))\n    except Exception:\n        pass\n\ntest_hashes = {}\nfor p, lbl, dom in tqdm(test_sample, desc=\"Test hashes\"):\n    try:\n        with Image.open(p) as img:\n            test_hashes[p] = str(imagehash.phash(img.convert('RGB'), hash_size=8))\n    except Exception:\n        pass\n\nprint(f\"\\n✅ Train hashes: {len(train_hashes)}  ({time.time()-t0:.1f}s)\")\nprint(f\"✅ Test hashes:  {len(test_hashes)}\")\n\n# ============================================================\n# Cross-match: train ↔ test\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  CROSS-MATCH: TRAIN ↔ TEST\")\nprint(\"=\"*70)\n\ntrain_ints = {p: int(h, 16) for p, h in train_hashes.items()}\ntest_ints  = {p: int(h, 16) for p, h in test_hashes.items()}\n\n# LSH-style bucketing\nmasks = [0xFFFF << 48, 0xFFFF << 32, 0xFFFF << 16, 0xFFFF]\ntrain_buckets = [defaultdict(list) for _ in masks]\nfor p, h in train_ints.items():\n    for b, mask in enumerate(masks):\n        train_buckets[b][h & mask].append(p)\n\nthreshold = 8\nleaked_test = []\nleaked_pairs = []\n\nfor tp, th in tqdm(test_ints.items(), desc=\"Cross-match\"):\n    candidates = set()\n    for b, mask in enumerate(masks):\n        candidates.update(train_buckets[b].get(th & mask, []))\n\n    for cp in candidates:\n        xor = th ^ train_ints[cp]\n        if bin(xor).count('1') <= threshold:\n            leaked_test.append(tp)\n            leaked_pairs.append((tp, cp, bin(xor).count('1')))\n            break\n\nleakage_rate = 100 * len(leaked_test) / max(1, len(test_ints))\n\nprint(f\"\\n{'='*70}\")\nprint(f\"  LEAKAGE ANALYSIS RESULT\")\nprint(f\"{'='*70}\")\nprint(f\"  Train sample size    : {len(train_hashes)}\")\nprint(f\"  Test sample size     : {len(test_hashes)}\")\nprint(f\"  Leaked test images   : {len(leaked_test)}\")\nprint(f\"  LEAKAGE RATE         : {leakage_rate:.2f}%\")\nprint(f\"{'='*70}\")\n\nprint(\"\\n  Sample leaked pairs (test ↔ train):\")\nfor tp, cp, d in leaked_pairs[:5]:\n    print(f\"    {os.path.basename(tp)}\")\n    print(f\"    ↔ {os.path.basename(cp)}\")\n    print(f\"      Hamming: {d}\")\n    print()\n\n# Save\nleakage_result = {\n    'train_sample_size': len(train_hashes),\n    'test_sample_size': len(test_hashes),\n    'leaked_test_count': len(leaked_test),\n    'leakage_rate_percent': leakage_rate,\n    'threshold_hamming': threshold,\n    'sample_pairs': [(os.path.basename(t), os.path.basename(c), d)\n                     for t, c, d in leaked_pairs[:20]],\n}\n\nwith open('/kaggle/working/leakage_analysis.json', 'w') as f:\n    json.dump(leakage_result, f, indent=2)\n\nprint(\"✅ Saved: leakage_analysis.json\")\nprint(\"=\"*70)\nprint(\"  ✅ CELL 5 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 6: Create Two Augmented Splits\n# ============================================================\n# Split A (Leaked):    Karthik's train_set/test_set as-is\n# Split B (Clean):     Parent-level split (no leakage)\n#\n# Parent ID from filename prefix (leading digits)\n\nimport os, json, re, random\nfrom collections import defaultdict\n\nprint(\"=\"*70)\nprint(\"  CREATE TWO AUGMENTED SPLITS\")\nprint(\"=\"*70)\n\nrandom.seed(42)\n\n# Load augmented data\nwith open('/kaggle/working/aug_data.json') as f:\n    aug_data = json.load(f)\n\nclass_to_idx = aug_data['class_to_idx']\nclass_to_domain = aug_data['class_to_domain']\n\n\n# ============================================================\n# Parent ID extractor\n# ============================================================\ndef extract_parent_id(filename):\n    \"\"\"Extract leading digits: '4687cashew_train_red rust.JPG' → '4687'\"\"\"\n    match = re.match(r'^(\\d+)', filename)\n    return match.group(1) if match else None\n\n\nprint(\"\\n✅ Parent ID extraction test:\")\nfor p, _, _ in aug_data['train'][:5]:\n    fname = os.path.basename(p)\n    pid = extract_parent_id(fname)\n    print(f\"   {fname:50s} → parent_id={pid}\")\n\n\n# ============================================================\n# SPLIT A: Karthik's Leaked (as-is)\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  SPLIT A: Karthik's Leaked (original)\")\nprint(\"=\"*70)\n\nsplit_leaked = {\n    'train': aug_data['train'],\n    'test':  aug_data['test'],\n    'class_to_idx': class_to_idx,\n    'class_to_domain': class_to_domain,\n}\n\nprint(f\"✅ Train: {len(split_leaked['train'])}\")\nprint(f\"✅ Test:  {len(split_leaked['test'])}\")\n\nwith open('/kaggle/working/split_leaked.json', 'w') as f:\n    json.dump(split_leaked, f)\nprint(\"✅ Saved: split_leaked.json\")\n\n\n# ============================================================\n# SPLIT B: Clean (parent-level, no leakage)\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  SPLIT B: Clean (parent-level)\")\nprint(\"=\"*70)\n\nall_aug = aug_data['train'] + aug_data['test']\nprint(f\"Combined total: {len(all_aug)}\")\n\n# Group by parent ID + crop + class (composite key)\nparent_to_images = defaultdict(list)\nno_parent = []\n\nfor path, lbl, dom in all_aug:\n    fname = os.path.basename(path)\n    pid = extract_parent_id(fname)\n    if pid:\n        # Composite key: (crop_class, pid)\n        key = (lbl, pid)\n        parent_to_images[key].append((path, lbl, dom))\n    else:\n        no_parent.append((path, lbl, dom))\n\nprint(f\"✅ Unique (class, parent_id) keys: {len(parent_to_images)}\")\nprint(f\"⚠️  Images without parent ID: {len(no_parent)}\")\n\n# Parent group sizes\ngroups_per_size = defaultdict(int)\nfor key, imgs in parent_to_images.items():\n    groups_per_size[len(imgs)] += 1\nprint(f\"\\n  Parent group sizes (top 5):\")\nfor size, count in sorted(groups_per_size.items(), key=lambda x: -x[1])[:5]:\n    print(f\"     size={size} → {count} groups\")\n\n\n# ============================================================\n# Per-class parent split (80/10/10)\n# ============================================================\nprint(f\"\\n{'='*70}\")\nprint(\"  PER-CLASS PARENT SPLIT (80/10/10)\")\nprint(f\"{'='*70}\")\n\n# Group keys by class\nclass_to_parent_keys = defaultdict(list)\nfor (lbl, pid), imgs in parent_to_images.items():\n    class_to_parent_keys[lbl].append((lbl, pid))\n\ntrain_clean, val_clean, test_clean = [], [], []\n\nfor lbl, keys in sorted(class_to_parent_keys.items()):\n    random.shuffle(keys)\n    n = len(keys)\n    n_train = int(0.8 * n)\n    n_val = int(0.1 * n)\n\n    train_keys = keys[:n_train]\n    val_keys = keys[n_train:n_train + n_val]\n    test_keys = keys[n_train + n_val:]\n\n    for key in train_keys:\n        train_clean.extend(parent_to_images[key])\n    for key in val_keys:\n        val_clean.extend(parent_to_images[key])\n    for key in test_keys:\n        test_clean.extend(parent_to_images[key])\n\nprint(f\"✅ Train: {len(train_clean)}\")\nprint(f\"✅ Val:   {len(val_clean)}\")\nprint(f\"✅ Test:  {len(test_clean)}\")\nprint(f\"✅ Total: {len(train_clean) + len(val_clean) + len(test_clean)}\")\n\n\n# ============================================================\n# Leakage verification\n# ============================================================\nprint(f\"\\n{'='*70}\")\nprint(\"  LEAKAGE VERIFICATION\")\nprint(f\"{'='*70}\")\n\ndef get_keys(imgs):\n    return set((lbl, extract_parent_id(os.path.basename(p)))\n               for p, lbl, _ in imgs)\n\ntrain_keys_set = get_keys(train_clean)\nval_keys_set = get_keys(val_clean)\ntest_keys_set = get_keys(test_clean)\n\noverlap_tr_te = train_keys_set & test_keys_set\noverlap_tr_va = train_keys_set & val_keys_set\noverlap_va_te = val_keys_set & test_keys_set\n\nprint(f\"  Train keys: {len(train_keys_set)}\")\nprint(f\"  Val keys:   {len(val_keys_set)}\")\nprint(f\"  Test keys:  {len(test_keys_set)}\")\nprint(f\"\\n  Train ∩ Test:  {len(overlap_tr_te)}  ← must be 0\")\nprint(f\"  Train ∩ Val:   {len(overlap_tr_va)}   ← must be 0\")\nprint(f\"  Val ∩ Test:    {len(overlap_va_te)}    ← must be 0\")\n\nif len(overlap_tr_te) == 0 and len(overlap_tr_va) == 0:\n    print(\"\\n  ✅ NO LEAKAGE — Clean split verified!\")\nelse:\n    print(f\"\\n  ⚠️  Leakage detected!\")\n\n\n# ============================================================\n# Save\n# ============================================================\nsplit_clean = {\n    'train': train_clean,\n    'val':   val_clean,\n    'test':  test_clean,\n    'class_to_idx': class_to_idx,\n    'class_to_domain': class_to_domain,\n}\n\nwith open('/kaggle/working/split_clean.json', 'w') as f:\n    json.dump(split_clean, f)\nprint(\"\\n✅ Saved: split_clean.json\")\n\n\n# ============================================================\n# Summary\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  SUMMARY\")\nprint(\"=\"*70)\nprint(f\"  Split A (Leaked):\")\nprint(f\"     Train: {len(split_leaked['train'])} | Test: {len(split_leaked['test'])}\")\nprint(f\"     Leakage: 8.50% (measured)\")\nprint(f\"\\n  Split B (Clean):\")\nprint(f\"     Train: {len(train_clean)} | Val: {len(val_clean)} | Test: {len(test_clean)}\")\nprint(f\"     Leakage: 0% (verified)\")\nprint(\"=\"*70)\nprint(\"  ✅ CELL 6 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 7: Model V2 Definition + Load All Splits\n# ============================================================\n# V2 upgrades over V1:\n#   BiMamba blocks:  6 → 8\n#   Hidden dim:      384 → 512\n#   Queries:         8 → 12\n#   Expected params: ~29-30M\n#\n# Novelty preserved:\n#   ✓ Vision Mamba (BiMamba backbone)\n#   ✓ Adaptive Query Generator\n#   ✓ Cross-Attention Fusion\n#   ✓ Multi-Scale Patch Embedding\n#   ✓ Background Suppression Module (BSM)\n\nimport os, json\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom mamba_ssm import Mamba\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ============================================================\n# Load all data\n# ============================================================\nprint(\"\\n[1] Loading Data\")\nprint(\"-\"*70)\n\n# Raw\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\nraw_train = raw_data['train']\nraw_val   = raw_data['val']\nraw_test  = raw_data['test']\nclass_to_idx = raw_data['class_to_idx']\n\nctd = raw_data['class_to_domain']\nif all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()):\n    class_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()}\nelse:\n    class_to_domain = {int(k): int(v) for k, v in ctd.items()}\n\nidx_to_class = {v: k for k, v in class_to_idx.items()}\nDIS_CLASSES  = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis  = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nprint(f\"✅ Raw:    {len(raw_train)}/{len(raw_val)}/{len(raw_test)}\")\n\n# Leaked\nwith open('/kaggle/working/split_leaked.json') as f:\n    leaked_split = json.load(f)\nprint(f\"✅ Leaked: {len(leaked_split['train'])}/{len(leaked_split['test'])}\")\n\n# Clean\nwith open('/kaggle/working/split_clean.json') as f:\n    clean_split = json.load(f)\nprint(f\"✅ Clean:  {len(clean_split['train'])}/{len(clean_split['val'])}/{len(clean_split['test'])}\")\n\nprint(f\"✅ Classes: {len(class_to_idx)} (Dis: {len(DIS_CLASSES)}, Pest: {len(PEST_CLASSES)})\")\n\n\n# ============================================================\n# Model Definition\n# ============================================================\nprint(\"\\n[2] Defining Model V2\")\nprint(\"-\"*70)\n\n\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__()\n        self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(\n            nn.Linear(ch, max(ch // 2, 4)), nn.ReLU(inplace=True),\n            nn.Linear(max(ch // 2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid()\n        self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2, 3], keepdim=True)\n        v = x.var([2, 3], keepdim=True, unbiased=False)\n        return 1 / (1 + torch.exp(-((x - mu) ** 2 / (4 * (v + e)) + 0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x))\n        f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2, -1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x * s * c * self.simam(x))\n\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__()\n        d3 = dim // 3\n        self.patch8  = nn.Conv2d(in_ch, d3, 8, 8)\n        self.patch16 = nn.Conv2d(in_ch, d3, 16, 16)\n        self.patch32 = nn.Conv2d(in_ch, dim - 2 * d3, 32, 32)\n        self.proj8  = nn.Linear(d3, dim)\n        self.proj16 = nn.Linear(d3, dim)\n        self.proj32 = nn.Linear(dim - 2 * d3, dim)\n        self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8  = self.proj8(self.patch8(x).flatten(2).transpose(1, 2))\n        p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2))\n        p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p  = F.adaptive_avg_pool1d(p8.transpose(1, 2), 196).transpose(1, 2)\n        p32u = F.interpolate(p32.transpose(1, 2), size=196,\n                             mode='nearest').transpose(1, 2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__()\n        self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e)\n        self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e)\n        self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x\n        xn = self.norm(x)\n        f = self.fwd(xn)\n        b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__()\n        self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim)\n        self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2)\n        K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2)\n        V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__()\n        self.m = m\n        self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(\n            nn.Linear(dim, dim), nn.GELU(),\n            nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]\n        base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1)\n        delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__()\n        self.dis_classes = dis_cls\n        self.pest_classes = pest_cls\n        self.bsm = BSM(3)\n        self.patch = MultiScalePatchEmbed(3, dim)\n        self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)])\n        self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2)\n        self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(),\n                                     nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(),\n                                      nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis  = nn.Linear(dim, dis_cls)\n        self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]\n        x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x)\n        global_feat = T.mean(dim=1)\n        dom_id = int(domain[0].item())\n        Q = self.qgen(global_feat, dom_id)\n        fused = self.ca(Q, T)\n        if dom_id == 0:\n            feat = self.mlp_dis(fused).mean(1)\n            return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else:\n            feat = self.mlp_pest(fused).mean(1)\n            return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n\n# ============================================================\n# Initialize + Test\n# ============================================================\nmodel_v2 = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nn_params = sum(p.numel() for p in model_v2.parameters()) / 1e6\n\nprint(f\"\\n✅ Model V2 initialized\")\nprint(f\"✅ Total params: {n_params:.2f}M\")\n\n# Component breakdown\nprint(\"\\n📊 Component-wise params:\")\nfor name, module in [('BSM', model_v2.bsm), ('MultiScalePatch', model_v2.patch),\n                     ('BiMamba × 8', model_v2.blocks), ('AdaptiveQuery', model_v2.qgen),\n                     ('CrossAttn', model_v2.ca), ('MLPs', [model_v2.mlp_dis, model_v2.mlp_pest]),\n                     ('Heads', [model_v2.head_dis, model_v2.head_pest])]:\n    n = sum(p.numel() for p in (module if isinstance(module, list) else [module]).__iter__() for p in (module.parameters() if hasattr(module, 'parameters') else [])) if not isinstance(module, list) else sum(sum(p.numel() for p in m.parameters()) for m in module)\n    print(f\"   {name:20s}: {n:>10,}  ({100 * n / (n_params * 1e6):.1f}%)\")\n\n# Forward test\nmodel_v2.eval()\nwith torch.no_grad():\n    ld, lp = model_v2(torch.randn(2, 3, 224, 224).to(device),\n                       torch.tensor([0, 1], device=device))\n    print(f\"\\n✅ Forward test: Disease {ld.shape}, Pest {lp.shape}\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  ✅ CELL 7 COMPLETE\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 8: Universal Training Setup\n# ============================================================\n# Provides:\n#   - CCMTDataset (works for raw, leaked, clean)\n#   - DomainBatchSampler\n#   - Focal Loss\n#   - Train/Eval functions\n#   - TTA function\n#\n# Reusable across all 3 model trainings.\n\nimport os, json, random, math, time\nfrom collections import Counter\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom tqdm import tqdm\n\nprint(\"=\"*70)\nprint(\"  TRAINING SETUP\")\nprint(\"=\"*70)\n\n# ============================================================\n# Config\n# ============================================================\nBATCH_SIZE = 8                # Reduced for V2 (38M params)\nGRAD_ACCUM_STEPS = 2          # Effective batch = 16\nMAX_GRAD_NORM = 1.0\nMAX_SANE_LOSS = 30.0\n\nIMAGENET_MEAN = [0.485, 0.456, 0.406]\nIMAGENET_STD  = [0.229, 0.224, 0.225]\n\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5),\n    transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\n\n# ============================================================\n# Dataset\n# ============================================================\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list\n        self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform:\n            img = self.transform(img)\n        # Remap to head-specific\n        if dom == 0:\n            lbl = global_to_dis[global_lbl]\n        else:\n            lbl = global_to_pest[global_lbl]\n        return img, lbl, dom\n\n\n# ============================================================\n# Domain-Routed Batch Sampler\n# ============================================================\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_, _, d) in enumerate(data_list) if d == 0]\n        self.pest_idx    = [i for i, (_, _, d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size\n        self.shuffle = shuffle\n\n    def __iter__(self):\n        if self.shuffle:\n            random.shuffle(self.disease_idx)\n            random.shuffle(self.pest_idx)\n        dis_batches  = [self.disease_idx[i:i + self.bs]\n                        for i in range(0, len(self.disease_idx), self.bs)]\n        pest_batches = [self.pest_idx[i:i + self.bs]\n                        for i in range(0, len(self.pest_idx), self.bs)]\n        all_batches = []\n        for i in range(max(len(dis_batches), len(pest_batches))):\n            if i < len(dis_batches):  all_batches.append(dis_batches[i])\n            if i < len(pest_batches): all_batches.append(pest_batches[i])\n        if self.shuffle:\n            random.shuffle(all_batches)\n        for b in all_batches:\n            yield b\n\n    def __len__(self):\n        return (math.ceil(len(self.disease_idx) / self.bs) +\n                math.ceil(len(self.pest_idx) / self.bs))\n\n\n# ============================================================\n# Class Weights\n# ============================================================\ndef compute_class_weights(data_list, head_classes, dom_filter,\n                          clip_min=0.3, clip_max=8.0):\n    global_labels = [d[1] for d in data_list if d[2] == dom_filter]\n    if dom_filter == 0:\n        head_labels = [global_to_dis[g] for g in global_labels]\n    else:\n        head_labels = [global_to_pest[g] for g in global_labels]\n    cnt = Counter(head_labels)\n    N = sum(cnt.values())\n    n_cls = len(head_classes)\n    w = [N / (n_cls * cnt.get(c, 1)) for c in range(n_cls)]\n    w = torch.tensor(w, dtype=torch.float32)\n    return torch.clamp(w, clip_min, clip_max).to(device)\n\n\n# ============================================================\n# Focal Loss\n# ============================================================\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n        self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets,\n                             weight=self.alpha,\n                             reduction='none',\n                             label_smoothing=self.ls)\n        pt = torch.exp(-ce)\n        return (((1 - pt) ** self.gamma) * ce).mean()\n\n\n# ============================================================\n# Loss + Accuracy helper\n# ============================================================\ndef compute_loss_acc(logits_dis, logits_pest, labels, domains,\n                     criterion_dis, criterion_pest):\n    dis_mask  = (domains == 0)\n    pest_mask = (domains == 1)\n    loss = torch.tensor(0.0, device=labels.device)\n    correct, total = 0, 0\n\n    if dis_mask.any():\n        a = logits_dis[dis_mask]; b = labels[dis_mask]\n        loss = loss + criterion_dis(a, b)\n        correct += (a.argmax(1) == b).sum().item()\n        total += b.size(0)\n\n    if pest_mask.any():\n        a = logits_pest[pest_mask]; b = labels[pest_mask]\n        loss = loss + criterion_pest(a, b)\n        correct += (a.argmax(1) == b).sum().item()\n        total += b.size(0)\n\n    return loss, correct, total\n\n\n# ============================================================\n# Train One Epoch (with gradient accumulation)\n# ============================================================\ndef train_one_epoch(model, loader, optimizer, criterion_dis, criterion_pest,\n                    desc=\"Train\"):\n    model.train()\n    total_loss, correct, total, skipped, valid = 0.0, 0, 0, 0, 0\n    accum_counter = 0\n\n    pbar = tqdm(loader, desc=desc)\n    for imgs, labels, domains in pbar:\n        imgs = imgs.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n        domains = domains.to(device, non_blocking=True)\n\n        logits_dis, logits_pest = model(imgs, domains)\n        loss, c, t = compute_loss_acc(logits_dis, logits_pest, labels, domains,\n                                      criterion_dis, criterion_pest)\n        loss = loss / GRAD_ACCUM_STEPS\n\n        if torch.isnan(loss) or torch.isinf(loss) or loss.item() > MAX_SANE_LOSS:\n            skipped += 1\n            optimizer.zero_grad(set_to_none=True)\n            accum_counter = 0\n            continue\n\n        loss.backward()\n        accum_counter += 1\n\n        if accum_counter >= GRAD_ACCUM_STEPS:\n            torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM)\n            optimizer.step()\n            optimizer.zero_grad(set_to_none=True)\n            accum_counter = 0\n\n        total_loss += loss.item() * GRAD_ACCUM_STEPS\n        correct += c; total += t; valid += 1\n        pbar.set_postfix({'L': f'{loss.item() * GRAD_ACCUM_STEPS:.3f}',\n                          'A': f'{100 * correct / max(1, total):.1f}%',\n                          'S': skipped})\n\n    # Final optimizer step if pending\n    if accum_counter > 0:\n        torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM)\n        optimizer.step()\n        optimizer.zero_grad(set_to_none=True)\n\n    return total_loss / max(1, valid), 100 * correct / max(1, total), skipped\n\n\n# ============================================================\n# Evaluate\n# ============================================================\n@torch.no_grad()\ndef evaluate(model, loader, criterion_dis, criterion_pest):\n    model.eval()\n    total_loss, correct, total, valid = 0.0, 0, 0, 0\n    dis_c, dis_t, pest_c, pest_t = 0, 0, 0, 0\n\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs = imgs.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n        domains = domains.to(device, non_blocking=True)\n\n        logits_dis, logits_pest = model(imgs, domains)\n        loss, c, t = compute_loss_acc(logits_dis, logits_pest, labels, domains,\n                                      criterion_dis, criterion_pest)\n        if torch.isnan(loss) or torch.isinf(loss):\n            continue\n\n        dis_mask  = (domains == 0)\n        pest_mask = (domains == 1)\n        if dis_mask.any():\n            a = logits_dis[dis_mask]; b = labels[dis_mask]\n            dis_c += (a.argmax(1) == b).sum().item()\n            dis_t += b.size(0)\n        if pest_mask.any():\n            a = logits_pest[pest_mask]; b = labels[pest_mask]\n            pest_c += (a.argmax(1) == b).sum().item()\n            pest_t += b.size(0)\n\n        total_loss += loss.item()\n        correct += c; total += t; valid += 1\n\n    return (total_loss / max(1, valid),\n            100 * correct / max(1, total),\n            100 * dis_c / max(1, dis_t),\n            100 * pest_c / max(1, pest_t))\n\n\n# ============================================================\n# Build DataLoaders from a split\n# ============================================================\ndef build_loaders(train_data, val_data=None, test_data=None):\n    train_ds = CCMTDataset(train_data, transform=train_tf)\n    train_sampler = DomainBatchSampler(train_data, BATCH_SIZE, shuffle=True)\n    train_loader = DataLoader(train_ds, batch_sampler=train_sampler,\n                              num_workers=2, pin_memory=True)\n\n    val_loader = None\n    if val_data is not None:\n        val_ds = CCMTDataset(val_data, transform=val_tf)\n        val_sampler = DomainBatchSampler(val_data, BATCH_SIZE, shuffle=False)\n        val_loader = DataLoader(val_ds, batch_sampler=val_sampler,\n                                num_workers=2, pin_memory=True)\n\n    test_loader = None\n    if test_data is not None:\n        test_ds = CCMTDataset(test_data, transform=val_tf)\n        test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE,\n                                 shuffle=False, num_workers=2, pin_memory=True)\n\n    return train_loader, val_loader, test_loader\n\n\n# ============================================================\n# Test-Time Augmentation\n# ============================================================\ndef tta_predict(model, img_pil, domain, n_aug=6):\n    \"\"\"TTA with 6 deterministic augmentations.\"\"\"\n    model.eval()\n    augs = [\n        img_pil,\n        img_pil.transpose(Image.FLIP_LEFT_RIGHT),\n        img_pil.transpose(Image.FLIP_TOP_BOTTOM),\n        img_pil.transpose(Image.ROTATE_180),\n        img_pil.transpose(Image.ROTATE_90),\n        img_pil.transpose(Image.ROTATE_270),\n    ]\n    all_probs = []\n    with torch.no_grad():\n        for aug in augs[:n_aug]:\n            t = val_tf(aug).unsqueeze(0).to(device)\n            d = torch.tensor([domain], device=device)\n            logits_dis, logits_pest = model(t, d)\n            logits = logits_dis if domain == 0 else logits_pest\n            probs = torch.softmax(logits, dim=1)[0]\n            all_probs.append(probs.cpu())\n    avg = torch.stack(all_probs).mean(dim=0)\n    return avg.argmax().item(), avg.max().item()\n\n\n# ============================================================\n# Setup DataLoaders for all 3 splits\n# ============================================================\nprint(\"\\n[1] Building DataLoaders\")\nprint(\"-\"*70)\n\n# Raw\nraw_train_loader, raw_val_loader, raw_test_loader = build_loaders(\n    raw_train, raw_val, raw_test\n)\nprint(f\"✅ Raw loaders: train={len(raw_train_loader)}, val={len(raw_val_loader)}\")\n\n# Leaked (train+test only)\nleaked_train_loader, _, leaked_test_loader = build_loaders(\n    leaked_split['train'], None, leaked_split['test']\n)\nprint(f\"✅ Leaked loaders: train={len(leaked_train_loader)}\")\n\n# Clean (train+val+test)\nclean_train_loader, clean_val_loader, clean_test_loader = build_loaders(\n    clean_split['train'], clean_split['val'], clean_split['test']\n)\nprint(f\"✅ Clean loaders: train={len(clean_train_loader)}, val={len(clean_val_loader)}\")\n\n\n# ============================================================\n# Class weights (for each split)\n# ============================================================\nprint(\"\\n[2] Computing Class Weights\")\nprint(\"-\"*70)\n\n# Raw\nraw_dis_w = compute_class_weights(raw_train, DIS_CLASSES, 0)\nraw_pest_w = compute_class_weights(raw_train, PEST_CLASSES, 1)\nprint(f\"✅ Raw:  dis[{raw_dis_w.min():.2f},{raw_dis_w.max():.2f}]  pest[{raw_pest_w.min():.2f},{raw_pest_w.max():.2f}]\")\n\n# Leaked\nleaked_dis_w = compute_class_weights(leaked_split['train'], DIS_CLASSES, 0)\nleaked_pest_w = compute_class_weights(leaked_split['train'], PEST_CLASSES, 1)\nprint(f\"✅ Leaked: dis[{leaked_dis_w.min():.2f},{leaked_dis_w.max():.2f}]  pest[{leaked_pest_w.min():.2f},{leaked_pest_w.max():.2f}]\")\n\n# Clean\nclean_dis_w = compute_class_weights(clean_split['train'], DIS_CLASSES, 0)\nclean_pest_w = compute_class_weights(clean_split['train'], PEST_CLASSES, 1)\nprint(f\"✅ Clean: dis[{clean_dis_w.min():.2f},{clean_dis_w.max():.2f}]  pest[{clean_pest_w.min():.2f},{clean_pest_w.max():.2f}]\")\n\n# Save class weights\nweights_data = {\n    'raw':    {'dis': raw_dis_w.cpu().tolist(), 'pest': raw_pest_w.cpu().tolist()},\n    'leaked': {'dis': leaked_dis_w.cpu().tolist(), 'pest': leaked_pest_w.cpu().tolist()},\n    'clean':  {'dis': clean_dis_w.cpu().tolist(), 'pest': clean_pest_w.cpu().tolist()},\n}\nwith open('/kaggle/working/class_weights.json', 'w') as f:\n    json.dump(weights_data, f)\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  ✅ CELL 8 COMPLETE — Training Setup Ready\")\nprint(\"=\"*70)\nprint(f\"  Batch size:        {BATCH_SIZE}\")\nprint(f\"  Grad accum:        {GRAD_ACCUM_STEPS} (effective {BATCH_SIZE * GRAD_ACCUM_STEPS})\")\nprint(f\"  Raw loaders:       {len(raw_train_loader)} train / {len(raw_val_loader)} val\")\nprint(f\"  Leaked loaders:    {len(leaked_train_loader)} train\")\nprint(f\"  Clean loaders:     {len(clean_train_loader)} train / {len(clean_val_loader)} val\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL 9: Train Model-A (Raw) — Extended + Early Stopping\n# ============================================================\n# Stage 1: 2 epochs warm-up\n# Stage 2: 25 epochs fine-tune\n# Early stopping: patience=5 (stop if no improvement for 5 epochs)\n# Time: ~1-1.5 hr\n\nimport pandas as pd\nimport time\nimport numpy as np\n\nprint(\"=\"*70)\nprint(\"  MODEL-A TRAINING (Raw) — Extended\")\nprint(\"=\"*70)\n\n# Fresh Model\nmodel_A = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nprint(f\"✅ Model-A: {sum(p.numel() for p in model_A.parameters())/1e6:.2f}M params\")\n\n# Focal Losses\ncrit_dis_A  = FocalLoss(alpha=raw_dis_w,  gamma=2.0).to(device)\ncrit_pest_A = FocalLoss(alpha=raw_pest_w, gamma=2.0).to(device)\n\nhistory_A = []\n\n\n# ============================================================\n# STAGE 1: Warm-up (2 epochs, LR=3e-5)\n# =========================================