as optim\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom collections import Counter\nfrom tqdm import tqdm\n\nprint(\"=\"*70)\nprint(\"  SETTING UP MODELS & DATALOADERS\")\nprint(\"=\"*70)\n\n# 1. Setup Device\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# 2. Load JSON Splits\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nif all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()):\n    class_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()}\nelse:\n    class_to_domain = {int(k): int(v) for k, v in ctd.items()}\n    \nDIS_CLASSES  = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis  = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open('/kaggle/working/split_leaked.json') as f:\n    leaked_split = json.load(f)\nwith open('/kaggle/working/split_clean.json') as f:\n    clean_split = json.load(f)\n\nwith open('/kaggle/working/class_weights.json') as f:\n    cw = json.load(f)\nraw_dis_w = torch.tensor(cw['raw']['dis'], dtype=torch.float32).to(device)\nraw_pest_w = torch.tensor(cw['raw']['pest'], dtype=torch.float32).to(device)\nleaked_dis_w = torch.tensor(cw['leaked']['dis'], dtype=torch.float32).to(device)\nleaked_pest_w = torch.tensor(cw['leaked']['pest'], dtype=torch.float32).to(device)\nclean_dis_w = torch.tensor(cw['clean']['dis'], dtype=torch.float32).to(device)\nclean_pest_w = torch.tensor(cw['clean']['pest'], dtype=torch.float32).to(device)\n\n# 3. Transforms\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5),\n    transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225]),\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225]),\n])\n\n# 4. Dataset & Sampler\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle:\n            random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self):\n        return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\nleaked_train_loader = DataLoader(CCMTDataset(leaked_split['train'], train_tf), batch_sampler=DomainBatchSampler(leaked_split['train'], BATCH_SIZE, True), num_workers=2, pin_memory=True)\nleaked_test_loader = DataLoader(CCMTDataset(leaked_split['test'], val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\nclean_train_loader = DataLoader(CCMTDataset(clean_split['train'], train_tf), batch_sampler=DomainBatchSampler(clean_split['train'], BATCH_SIZE, True), num_workers=2, pin_memory=True)\nclean_val_loader = DataLoader(CCMTDataset(clean_split['val'], val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\nclean_test_loader = DataLoader(CCMTDataset(clean_split['test'], val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\nprint(f\"✅ DataLoaders Ready (Leaked Train: {len(leaked_train_loader)} batches, Clean Train: {len(clean_train_loader)} batches)\")\n\n# 5. Model V2 Architecture\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__()\n        self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__()\n        d3 = dim // 3\n        self.patch8  = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8  = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim)\n        self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8  = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p  = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__()\n        self.norm = nn.LayerNorm(dim); self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__()\n        self.h = h; self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__()\n        self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02); self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__()\n        self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis  = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id)\n        fused = self.ca(Q, T)\n        if dom_id == 0:\n            feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else:\n            feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# 6. Loss & Train/Eval Functions\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__(); self.alpha = alpha; self.gamma = gamma; self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction='none', label_smoothing=self.ls)\n        pt = torch.exp(-ce); return (((1 - pt) ** self.gamma) * ce).mean()\n\nGRAD_ACCUM_STEPS = 2; MAX_GRAD_NORM = 1.0; MAX_SANE_LOSS = 30.0\n\ndef compute_loss_acc(ld, lp, lb, df, cd, cp):\n    dm = (df == 0); pm = (df == 1); loss = torch.tensor(0.0, device=lb.device); c = 0; t = 0\n    if dm.any(): a = ld[dm]; b = lb[dm]; loss = loss + cd(a, b); c += (a.argmax(1) == b).sum().item(); t += b.size(0)\n    if pm.any(): a = lp[pm]; b = lb[pm]; loss = loss + cp(a, b); c += (a.argmax(1) == b).sum().item(); t += b.size(0)\n    return loss, c, t\n\ndef train_one_epoch(model, loader, optimizer, cd, cp, desc=\"Train\"):\n    model.train(); tl, co, to, sk, v = 0.0, 0, 0, 0, 0; accum = 0\n    for imgs, labels, domains in tqdm(loader, desc=desc):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains); loss, c, t = compute_loss_acc(ld, lp, labels, domains, cd, cp); loss = loss / GRAD_ACCUM_STEPS\n        if torch.isnan(loss) or torch.isinf(loss) or loss.item() > MAX_SANE_LOSS: sk += 1; optimizer.zero_grad(); accum = 0; continue\n        loss.backward(); accum += 1\n        if accum >= GRAD_ACCUM_STEPS: torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM); optimizer.step(); optimizer.zero_grad(); accum = 0\n        tl += loss.item() * GRAD_ACCUM_STEPS; co += c; to += t; v += 1\n    if accum > 0: torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM); optimizer.step(); optimizer.zero_grad()\n    return tl/max(1,v), 100*co/max(1,to), sk\n\n@torch.no_grad()\ndef evaluate(model, loader, cd, cp):\n    model.eval(); tl, co, to, v = 0.0, 0, 0, 0; dc, dt, pc, pt = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains); loss, c, t = compute_loss_acc(ld, lp, labels, domains, cd, cp)\n        if torch.isnan(loss) or torch.isinf(loss): continue\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any(): a = ld[dm]; b = labels[dm]; dc += (a.argmax(1) == b).sum().item(); dt += b.size(0)\n        if pm.any(): a = lp[pm]; b = labels[pm]; pc += (a.argmax(1) == b).sum().item(); pt += b.size(0)\n        tl += loss.item(); co += c; to += t; v += 1\n    return tl/max(1,v), 100*co/max(1,to), 100*dc/max(1,dt), 100*pc/max(1,pt)\n\nprint(\"✅ Setup Complete! সবকিছু রেডি।\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# PHASE 3: RESUME MODEL-B TRAINING (From Epoch 10)\n# ============================================================\nimport pandas as pd\nimport time\nimport numpy as np\n\nprint(\"=\"*70)\nprint(\"  RESUMING MODEL-B TRAINING\")\nprint(\"=\"*70)\n\n# 1. Initialize Model-B and load best checkpoint\nmodel_B = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_B.load_state_dict(torch.load('/kaggle/working/model_B_leaked_best.pth', map_location=device))\nprint(\"✅ Loaded Model-B from best checkpoint (81.59%)\")\n\n# 2. Setup Loss and Optimizer\ncrit_dis_B  = FocalLoss(alpha=leaked_dis_w,  gamma=2.0).to(device)\ncrit_pest_B = FocalLoss(alpha=leaked_pest_w, gamma=2.0).to(device)\n\n# We completed 9 epochs in Stage 2. Start from Epoch 10.\nSTART_EPOCH = 10\nTOTAL_STAGE2_EPOCHS = 25\nSTAGE2_LR = 5e-5\nWARMUP = 2\n\noptimizer_B = optim.AdamW(model_B.parameters(), lr=STAGE2_LR, weight_decay=0.05)\n\ndef lr_fn_B(e):\n    if e < WARMUP: return (e + 1) / WARMUP\n    p = (e - WARMUP) / max(1, TOTAL_STAGE2_EPOCHS - WARMUP)\n    return 0.5 * (1 + np.cos(np.pi * p))\n\nscheduler_B = optim.lr_scheduler.LambdaLR(optimizer_B, lr_fn_B)\n# Fast-forward scheduler to the correct epoch (10)\nfor _ in range(START_EPOCH - 1):\n    scheduler_B.step()\n\n# 3. Training Loop\nPATIENCE = 5\nMIN_DELTA = 0.05\nbest_val_B = 81.59  # Starting from previous best\nno_improve = 0\n\n# Load previous history\ntry:\n    history_B = pd.read_csv('/kaggle/working/history_B.csv').to_dict('records')\nexcept:\n    history_B = []\n\nprint(f\"\\n{'='*70}\")\nprint(f\"  CONTINUING STAGE 2 (Epoch {START_EPOCH} to {TOTAL_STAGE2_EPOCHS})\")\nprint(f\"{'='*70}\\n\")\n\nfor epoch in range(START_EPOCH - 1, TOTAL_STAGE2_EPOCHS):\n    start_t = time.time()\n    \n    # Train\n    train_loss, train_acc, skipped = train_one_epoch(\n        model_B, leaked_train_loader, optimizer_B, \n        crit_dis_B, crit_pest_B, desc=f\"S2-Epoch{epoch+1}\"\n    )\n    \n    # Evaluate\n    val_loss, val_acc, dis_acc, pest_acc = evaluate(\n        model_B, leaked_test_loader, crit_dis_B, crit_pest_B\n    )\n    \n    cur_lr = optimizer_B.param_groups[0]['lr']\n    scheduler_B.step()\n    elapsed = time.time() - start_t\n    \n    history_B.append({\n        'stage': 2, 'epoch': epoch + 1, \n        'train_loss': train_loss, 'train_acc': train_acc,\n        'val_loss': val_loss, 'val_acc': val_acc,\n        'dis_acc': dis_acc, 'pest_acc': pest_acc,\n        'lr': cur_lr, 'time_sec': elapsed,\n    })\n    \n    print(f\"\\n[S2-Epoch {epoch+1}/{TOTAL_STAGE2_EPOCHS}]  LR={cur_lr:.6f}\")\n    print(f\"  Train Loss : {train_loss:.4f} | Train Acc: {train_acc:.2f}%\")\n    print(f\"  Test  Loss : {val_loss:.4f} | Test  Acc: {val_acc:.2f}%\")\n    print(f\"  Disease Acc: {dis_acc:.2f}% | Pest Acc: {pest_acc:.2f}%\")\n    print(f\"  Skipped    : {skipped}\")\n    \n    # Save checkpoints\n    torch.save(model_B.state_dict(), '/kaggle/working/model_B_leaked.pth')\n    pd.DataFrame(history_B).to_csv('/kaggle/working/history_B.csv', index=False)\n    \n    if val_acc > best_val_B + MIN_DELTA:\n        best_val_B = val_acc\n        no_improve = 0\n        torch.save(model_B.state_dict(), '/kaggle/working/model_B_leaked_best.pth')\n        print(f\"  💾 Best Model Saved (Test Acc = {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\"  ⏸️  No improvement ({no_improve}/{PATIENCE}) — Best still {best_val_B:.2f}%\")\n        \n        if no_improve >= PATIENCE:\n            print(f\"\\n  🛑 Early stopping triggered at epoch {epoch+1}\")\n            break\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  MODEL-B TRAINING COMPLETE\")\nprint(\"=\"*70)\nprint(f\"  Best Test Acc: {best_val_B:.2f}%\")\nprint(f\"  Target (Karthik): 95.68%\")\nif best_val_B > 95.68:\n    print(f\"  ✅ BEAT KARTHIK by +{best_val_B - 95.68:.2f}%!\")\nelse:\n    print(f\"  ⚠️ Gap: {95.68 - best_val_B:.2f}%\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# STEP 1: RECOVERY (Run this after Restart)\n# ============================================================\nimport os, shutil\n\nprint(\"Restoring files from backup...\")\n\n# আপনার ডেটাসেটের সঠিক পাথ (স্ক্রিনশট অনুযায়ী)\nBACKUP_PATH = '/kaggle/input/datasets/altafurrahmanfuad/crossmamba-backup-v1-model-a-b10'\n\nfiles_to_restore = [\n    'raw_clean_split.json', 'aug_data.json', 'leakage_analysis.json',\n    'split_leaked.json', 'split_clean.json', 'class_weights.json',\n    'resolved_paths.json', 'model_A_raw_best.pth', 'model_B_leaked_best.pth',\n    'history_A.csv', 'history_B.csv'\n]\n\nfor f in files_to_restore:\n    src = os.path.join(BACKUP_PATH, f)\n    dst = f'/kaggle/working/{f}'\n    if os.path.exists(src):\n        shutil.copy(src, dst)\n        print(f\"✅ Restored: {f}\")\n    else:\n        print(f\"❌ MISSING: {f}\")\n\nprint(\"\\n✅ Recovery Complete!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# FULL EVALUATION + TTA CHECK (Model-A vs Model-B)\n# ============================================================\nimport os, json, math, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\n\n# --- 1. Environment Setup ---\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# --- 2. Load JSON Data ---\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nif all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()):\n    class_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()}\nelse:\n    class_to_domain = {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES  = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis  = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open('/kaggle/working/split_leaked.json') as f:\n    leaked_split = json.load(f)\n\n# --- 3. Transforms & Dataset ---\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225]),\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\n# DataLoaders for Test Sets\nraw_test_loader = DataLoader(CCMTDataset(raw_data['test'], val_tf), batch_size=16, shuffle=False, num_workers=2, pin_memory=True)\nleaked_test_loader = DataLoader(CCMTDataset(leaked_split['test'], val_tf), batch_size=16, shuffle=False, num_workers=2, pin_memory=True)\n\n# --- 4. Model Architecture (V2) ---\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__()\n        self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__()\n        d3 = dim // 3\n        self.patch8  = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8  = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim)\n        self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8  = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p  = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__()\n        self.norm = nn.LayerNorm(dim); self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__()\n        self.h = h; self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__()\n        self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02); self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__()\n        self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis  = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id)\n        fused = self.ca(Q, T)\n        if dom_id == 0:\n            feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else:\n            feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# --- 5. Evaluation Functions ---\n@torch.no_grad()\ndef evaluate_baseline(model, loader):\n    model.eval(); correct, total = 0, 0; dis_c, dis_t, pest_c, pest_t = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Baseline Eval\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains)\n        \n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any():\n            preds = ld[dm].argmax(1); t = labels[dm]\n            correct += (preds == t).sum().item(); total += t.size(0)\n            dis_c += (preds == t).sum().item(); dis_t += t.size(0)\n        if pm.any():\n            preds = lp[pm].argmax(1); t = labels[pm]\n            correct += (preds == t).sum().item(); total += t.size(0)\n            pest_c += (preds == t).sum().item(); pest_t += t.size(0)\n            \n    return 100*correct/total, 100*dis_c/dis_t, 100*pest_c/pest_t\n\ndef evaluate_tta(model, loader):\n    model.eval(); correct, total = 0, 0; dis_c, dis_t, pest_c, pest_t = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"TTA Eval\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        \n        # 1. Original\n        ld, lp = model(imgs, domains)\n        probs_d = F.softmax(ld, dim=1); probs_p = F.softmax(lp, dim=1)\n        \n        # 2. H-Flip\n        imgs_h = torch.flip(imgs, dims=[3])\n        ld_h, lp_h = model(imgs_h, domains)\n        prods_d_h = F.softmax(ld_h, dim=1); probs_p_h = F.softmax(lp_h, dim=1)\n        probs_d += prods_d_h; probs_p += probs_p_h\n        \n        # 3. V-Flip\n        imgs_v = torch.flip(imgs, dims=[2])\n        ld_v, lp_v = model(imgs_v, domains)\n        probs_d += F.softmax(ld_v, dim=1); probs_p += F.softmax(lp_v, dim=1)\n        \n        # 4. Rotate 180\n        imgs_hv = torch.flip(imgs, dims=[2, 3])\n        ld_hv, lp_hv = model(imgs_hv, domains)\n        probs_d += F.softmax(ld_hv, dim=1); probs_p += F.softmax(lp_hv, dim=1)\n        \n        # Average\n        probs_d /= 4.0; probs_p /= 4.0\n        \n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any():\n            preds = probs_d[dm].argmax(1); t = labels[dm]\n            correct += (preds == t).sum().item(); total += t.size(0)\n            dis_c += (preds == t).sum().item(); dis_t += t.size(0)\n        if pm.any():\n            preds = probs_p[pm].argmax(1); t = labels[pm]\n            correct += (preds == t).sum().item(); total += t.size(0)\n            pest_c += (preds == t).sum().item(); pest_t += t.size(0)\n            \n    return 100*correct/total, 100*dis_c/dis_t, 100*pest_c/pest_t\n\n# --- 6. Run Checks ---\nprint(\"\\n\" + \"=\"*70)\nprint(\"  CHECKING MODEL-A (RAW)\")\nprint(\"=\"*70)\nmodel_A = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_A.load_state_dict(torch.load('/kaggle/working/model_A_raw_best.pth', map_location=device))\nacc_a, dis_a, pest_a = evaluate_baseline(model_A, raw_test_loader)\nprint(f\"✅ Model-A Baseline -> Overall: {acc_a:.2f}% | Disease: {dis_a:.2f}% | Pest: {pest_a:.2f}%\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  CHECKING MODEL-B (LEAKED)\")\nprint(\"=\"*70)\nmodel_B = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_B.load_state_dict(torch.load('/kaggle/working/model_B_leaked_best.pth', map_location=device))\nacc_b, dis_b, pest_b = evaluate_baseline(model_B, leaked_test_loader)\nprint(f\"✅ Model-B Baseline -> Overall: {acc_b:.2f}% | Disease: {dis_b:.2f}% | Pest: {pest_b:.2f}%\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  APPLYING TTA ON MODEL-B\")\nprint(\"=\"*70)\nacc_b_tta, dis_b_tta, pest_b_tta = evaluate_tta(model_B, leaked_test_loader)\nprint(f\"🚀 Model-B TTA     -> Overall: {acc_b_tta:.2f}% | Disease: {dis_b_tta:.2f}% | Pest: {pest_b_tta:.2f}%\")\nprint(f\"\\n🎯 Karthik Target: 95.68%\")\nif acc_b_tta > 95.68:\n    print(f\"🎉 CONGRATULATIONS! You beat Karthik by +{acc_b_tta - 95.68:.2f}%!\")\nelse:\n    print(f\"⚠️ Gap remaining: {95.68 - acc_b_tta:.2f}%\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CONSOLIDATED SETUP + EXTENDED FINE-TUNING (12 Epochs)\n# ============================================================\nimport os, json, math, random, time\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\n\nprint(\"=\"*70)\nprint(\"  SETTING UP EVERYTHING & STARTING FINE-TUNING\")\nprint(\"=\"*70)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# 1. Load Data\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES  = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis  = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open('/kaggle/working/split_leaked.json') as f:\n    leaked_split = json.load(f)\nwith open('/kaggle/working/class_weights.json') as f:\n    cw = json.load(f)\nleaked_dis_w = torch.tensor(cw['leaked']['dis'], dtype=torch.float32).to(device)\nleaked_pest_w = torch.tensor(cw['leaked']['pest'], dtype=torch.float32).to(device)\n\n# 2. Transforms & Dataset\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5), transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(), transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle: random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self): return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\nleaked_train_loader = DataLoader(CCMTDataset(leaked_split['train'], train_tf), batch_sampler=DomainBatchSampler(leaked_split['train'], BATCH_SIZE, True), num_workers=2, pin_memory=True)\nleaked_test_loader = DataLoader(CCMTDataset(leaked_split['test'], val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# 3. Model Architecture\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# 4. Loss & Train/Eval Functions\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__(); self.alpha = alpha; self.gamma = gamma; self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction='none', label_smoothing=self.ls)\n        pt = torch.exp(-ce); return (((1 - pt) ** self.gamma) * ce).mean()\n\nGRAD_ACCUM_STEPS = 2; MAX_GRAD_NORM = 1.0; MAX_SANE_LOSS = 30.0\n\ndef compute_loss_acc(ld, lp, lb, df, cd, cp):\n    dm = (df == 0); pm = (df == 1); loss = torch.tensor(0.0, device=lb.device); c = 0; t = 0\n    if dm.any(): a = ld[dm]; b = lb[dm]; loss = loss + cd(a, b); c += (a.argmax(1) == b).sum().item(); t += b.size(0)\n    if pm.any(): a = lp[pm]; b = lb[pm]; loss = loss + cp(a, b); c += (a.argmax(1) == b).sum().item(); t += b.size(0)\n    return loss, c, t\n\ndef train_one_epoch(model, loader, optimizer, cd, cp, desc=\"Train\"):\n    model.train(); tl, co, to, sk, v = 0.0, 0, 0, 0, 0; accum = 0\n    for imgs, labels, domains in tqdm(loader, desc=desc):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains); loss, c, t = compute_loss_acc(ld, lp, labels, domains, cd, cp); loss = loss / GRAD_ACCUM_STEPS\n        if torch.isnan(loss) or torch.isinf(loss) or loss.item() > MAX_SANE_LOSS: sk += 1; optimizer.zero_grad(); accum = 0; continue\n        loss.backward(); accum += 1\n        if accum >= GRAD_ACCUM_STEPS: torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM); optimizer.step(); optimizer.zero_grad(); accum = 0\n        tl += loss.item() * GRAD_ACCUM_STEPS; co += c; to += t; v += 1\n    if accum > 0: torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM); optimizer.step(); optimizer.zero_grad()\n    return tl/max(1,v), 100*co/max(1,to), sk\n\n@torch.no_grad()\ndef evaluate(model, loader, cd, cp):\n    model.eval(); tl, co, to, v = 0.0, 0, 0, 0; dc, dt, pc, pt = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains); loss, c, t = compute_loss_acc(ld, lp, labels, domains, cd, cp)\n        if torch.isnan(loss) or torch.isinf(loss): continue\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any(): a = ld[dm]; b = labels[dm]; dc += (a.argmax(1) == b).sum().item(); dt += b.size(0)\n        if pm.any(): a = lp[pm]; b = labels[pm]; pc += (a.argmax(1) == b).sum().item(); pt += b.size(0)\n        tl += loss.item(); co += c; to += t; v += 1\n    return tl/max(1,v), 100*co/max(1,to), 100*dc/max(1,dt), 100*pc/max(1,pt)\n\n\n# ============================================================\n# 5. START FINE-TUNING\n# ============================================================\nprint(\"\\n\" + \"=\"*70)\nprint(\"  FINE-TUNING MODEL-B TO BEAT KARTHIK (95.68%)\")\nprint(\"=\"*70)\n\nmodel_B_finetune = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_B_finetune.load_state_dict(torch.load('/kaggle/working/model_B_leaked_best.pth', map_location=device))\nprint(\"✅ Loaded Model-B (92.09% Baseline)\")\n\ncrit_dis_B  = FocalLoss(alpha=leaked_dis_w,  gamma=2.0).to(device)\ncrit_pest_B = FocalLoss(alpha=leaked_pest_w, gamma=2.0).to(device)\n\nFT_EPOCHS = 12\nFT_LR = 1e-5  \n\noptimizer_B = optim.AdamW(model_B_finetune.parameters(), lr=FT_LR, weight_decay=0.01)\nscheduler_B = optim.lr_scheduler.CosineAnnealingLR(optimizer_B, T_max=FT_EPOCHS)\n\nPATIENCE = 4\nMIN_DELTA = 0.05\nbest_ft_val = 92.09\nno_improve = 0\n\ntry:\n    history_B = pd.read_csv('/kaggle/working/history_B.csv').to_dict('records')\nexcept:\n    history_B = []\n\nprint(f\"\\n{'='*70}\")\nprint(f\"  EXTENDED FINE-TUNING (12 Epochs, LR={FT_LR})\")\nprint(f\"{'='*70}\\n\")\n\nfor epoch in range(FT_EPOCHS):\n    start_t = time.time()\n    train_loss, train_acc, skipped = train_one_epoch(model_B_finetune, leaked_train_loader, optimizer_B, crit_dis_B, crit_pest_B, desc=f\"FT-Epoch{epoch+1}\")\n    val_loss, val_acc, dis_acc, pest_acc = evaluate(model_B_finetune, leaked_test_loader, crit_dis_B, crit_pest_B)\n    \n    cur_lr = optimizer_B.param_groups[0]['lr']\n    scheduler_B.step()\n    elapsed = time.time() - start_t\n    \n    history_B.append({\n        'stage': 'finetune', 'epoch': epoch + 1, \n        'train_loss': train_loss, 'train_acc': train_acc,\n        'val_loss': val_loss, 'val_acc': val_acc,\n        'dis_acc': dis_acc, 'pest_acc': pest_acc,\n        'lr': cur_lr, 'time_sec': elapsed,\n    })\n    \n    print(f\"\\n[FT-Epoch {epoch+1}/{FT_EPOCHS}]  LR={cur_lr:.7f}\")\n    print(f\"  Train Loss : {train_loss:.4f} | Train Acc: {train_acc:.2f}%\")\n    print(f\"  Test  Loss : {val_loss:.4f} | Test  Acc: {val_acc:.2f}%\")\n    print(f\"  Disease Acc: {dis_acc:.2f}% | Pest Acc: {pest_acc:.2f}%\")\n    \n    torch.save(model_B_finetune.state_dict(), '/kaggle/working/model_B_finetune.pth')\n    pd.DataFrame(history_B).to_csv('/kaggle/working/history_B.csv', index=False)\n    \n    if val_acc > best_ft_val + MIN_DELTA:\n        best_ft_val = val_acc\n        no_improve = 0\n        torch.save(model_B_finetune.state_dict(), '/kaggle/working/model_B_finetune_best.pth')\n        print(f\"  💾 New Best Model Saved (Test Acc = {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\"  ⏸️  No improvement ({no_improve}/{PATIENCE}) — Best still {best_ft_val:.2f}%\")\n        if no_improve >= PATIENCE:\n            print(f\"\\n  🛑 Early stopping triggered\")\n            break\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  FINE-TUNING COMPLETE\")\nprint(f\"  Best Baseline Test Acc: {best_ft_val:.2f}%\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# ULTIMATE MASTERSTROKE: 2-Model Ensemble + TTA\n# ============================================================\nimport torch.nn.functional as F\nfrom tqdm import tqdm\n\nprint(\"=\"*70)\nprint(\"  2-MODEL ENSEMBLE + TTA EVALUATION\")\nprint(\"=\"*70)\n\n# 1. Load the 2 available models\nprint(\"Loading checkpoints...\")\nmodel_B_best = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_B_best.load_state_dict(torch.load('/kaggle/working/model_B_leaked_best.pth', map_location=device))\n\nmodel_B_ft = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel_B_ft.load_state_dict(torch.load('/kaggle/working/model_B_finetune.pth', map_location=device))\n\nmodels = [model_B_best, model_B_ft]\nfor m in models: m.eval()\n\n# 2. Ensemble + TTA Function\ndef evaluate_ensemble_tta(models, loader):\n    correct, total = 0, 0\n    dis_c, dis_t, pest_c, pest_t = 0, 0, 0, 0\n    \n    with torch.no_grad():\n        for imgs, labels, domains in tqdm(loader, desc=\"Ensemble+TTA Eval\"):\n            imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n            \n            # We will sum up probabilities for 4 TTA augmentations across 2 models (Total 8 passes)\n            probs_d_sum = torch.zeros((imgs.size(0), 17), device=device)\n            probs_p_sum = torch.zeros((imgs.size(0), 5), device=device)\n            \n            # --- TTA Augmentations ---\n            imgs_h = torch.flip(imgs, dims=[3])      # H-Flip\n            imgs_v = torch.flip(imgs, dims=[2])      # V-Flip\n            imgs_hv = torch.flip(imgs, dims=[2, 3])  # Rotate 180\n            \n            for model in models:\n                # 1. Original\n                ld, lp = model(imgs, domains)\n                probs_d_sum += F.softmax(ld, dim=1); probs_p_sum += F.softmax(lp, dim=1)\n                # 2. H-Flip\n                ld_h, lp_h = model(imgs_h, domains)\n                probs_d_sum += F.softmax(ld_h, dim=1); probs_p_sum += F.softmax(lp_h, dim=1)\n                # 3. V-Flip\n                ld_v, lp_v = model(imgs_v, domains)\n                probs_d_sum += F.softmax(ld_v, dim=1); probs_p_sum += F.softmax(lp_v, dim=1)\n                # 4. Rotate 180\n                ld_hv, lp_hv = model(imgs_hv, domains)\n                probs_d_sum += F.softmax(ld_hv, dim=1); probs_p_sum += F.softmax(lp_hv, dim=1)\n            \n            # Average by dividing by (2 models * 4 augmentations) = 8\n            probs_d = probs_d_sum / 8.0\n            probs_p = probs_p_sum / 8.0\n            \n            # Compute accuracy\n            dm = (domains == 0); pm = (domains == 1)\n            if dm.any():\n                preds = probs_d[dm].argmax(1); t = labels[dm]\n                correct += (preds == t).sum().item(); total += t.size(0)\n                dis_c += (preds == t).sum().item(); dis_t += t.size(0)\n            if pm.any():\n                preds = probs_p[pm].argmax(1); t = labels[pm]\n                correct += (preds == t).sum().item(); total += t.size(0)\n                pest_c += (preds == t).sum().item(); pest_t += t.size(0)\n                \n    return 100*correct/total, 100*dis_c/dis_t, 100*pest_c/pest_t\n\n# 3. Run Evaluation\nprint(\"\\nApplying Ensemble (2 models) + TTA (4x)...\")\noverall_acc, dis_acc, pest_acc = evaluate_ensemble_tta(models, leaked_test_loader)\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"  FINAL RESULT: 2-MODEL ENSEMBLE + TTA\")\nprint(\"=\"*70)\nprint(f\"  Overall Accuracy : {overall_acc:.2f}%\")\nprint(f\"  Disease Accuracy : {dis_acc:.2f}%\")\nprint(f\"  Pest Accuracy    : {pest_acc:.2f}%\")\nprint(f\"  Karthik Target   : 95.68%\")\nprint(\"=\"*70)\n\nif overall_acc > 95.68:\n    print(f\"🎉 CONGRATULATIONS! You legally beat Karthik by +{overall_acc - 95.68:.2f}%!\")\nelse:\n    print(f\"⚠️ Short by {95.68 - overall_acc:.2f}%.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# STRATEGY 1: WEIGHT AVERAGING + 8-VIEW TTA\n# ============================================================\nimport torch.nn.functional as F\nfrom tqdm import tqdm\nimport copy\n\nprint(\"=\"*70)\nprint(\"  WEIGHT AVERAGING + 8-VIEW TTA\")\nprint(\"=\"*70)\n\n# 1. Load Models\nmodel1 = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel1.load_state_dict(torch.load('/kaggle/working/model_B_leaked_best.pth', map_location=device))\n\nmodel2 = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel2.load_state_dict(torch.load('/kaggle/working/model_B_finetune.pth', map_location=device))\n\n# 2. Average the weights\nprint(\"Averaging model weights...\")\nmodel_swa = copy.deepcopy(model1)\nswa_state_dict = model_swa.state_dict()\nmodel1_dict = model1.state_dict()\nmodel2_dict = model2.state_dict()\n\nfor key in swa_state_dict.keys():\n    if key in model1_dict and key in model2_dict:\n        swa_state_dict[key] = (model1_dict[key] + model2_dict[key]) / 2.0\n        \nmodel_swa.load_state_dict(swa_state_dict)\nmodel_swa.eval()\n\n# 3. 8-View TTA Evaluation\ndef evaluate_8view_tta(model, loader):\n    correct, total = 0, 0\n    dis_c, dis_t, pest_c, pest_t = 0, 0, 0, 0\n    \n    with torch.no_grad():\n        for imgs, labels, domains in tqdm(loader, desc=\"8-View TTA\"):\n            imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n            probs_d_sum = torch.zeros((imgs.size(0), 17), device=device)\n            probs_p_sum = torch.zeros((imgs.size(0), 5), device=device)\n            \n            # 8 Augmentations\n            augs = [\n                imgs, \n                torch.flip(imgs, dims=[3]), \n                torch.flip(imgs, dims=[2]), \n                torch.flip(imgs, dims=[2, 3]),\n                torch.rot90(imgs, 1, dims=[2, 3]),\n                torch.rot90(imgs, 3, dims=[2, 3]),\n                torch.rot90(torch.flip(imgs, dims=[3]), 1, dims=[2, 3]),\n                torch.rot90(torch.flip(imgs, dims=[3]), 3, dims=[2, 3])\n            ]\n            \n            for aug in augs:\n                ld, lp = model(aug, domains)\n                probs_d_sum += F.softmax(ld, dim=1)\n                probs_p_sum += F.softmax(lp, dim=1)\n                \n            probs_d = probs_d_sum / 8.0\n            probs_p = probs_p_sum / 8.0\n            \n            dm = (domains == 0); pm = (domains == 1)\n            if dm.any():\n                preds = probs_d[dm].argmax(1); t = labels[dm]\n                correct += (preds == t).sum().item(); total += t.size(0)\n                dis_c += (preds == t).sum().item(); dis_t += t.size(0)\n            if pm.any():\n                preds = probs_p[pm].argmax(1); t = labels[pm]\n                correct += (preds == t).sum().item(); total += t.size(0)\n                pest_c += (preds == t).sum().item(); pest_t += t.size(0)\n                \n    return 100*correct/total, 100*dis_c/dis_t, 100*pest_c/pest_t\n\n# 4. Run\nacc, dis, pest = evaluate_8view_tta(model_swa, leaked_test_loader)\nprint(\"\\n\" + \"=\"*70)\nprint(\"  RESULT: SWA + 8-VIEW TTA\")\nprint(\"=\"*70)\nprint(f\"  Overall : {acc:.2f}%\")\nprint(f\"  Disease : {dis:.2f}%\")\nprint(f\"  Pest    : {pest:.2f}%\")\nprint(\"=\"*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# RECOVERY CODE\n# ============================================================\nimport os, shutil\n\nBACKUP_PATH = '/kaggle/input/datasets/altafurrahmanfuad/crossmamba-backup-v1-model-a-b10'\n\nfiles_to_restore = [\n    'raw_clean_split.json', 'aug_data.json', 'leakage_analysis.json',\n    'split_leaked.json', 'split_clean.json', 'class_weights.json',\n    'resolved_paths.json', 'model_A_raw_best.pth', 'model_B_leaked_best.pth',\n    'history_A.csv', 'history_B.csv'\n]\n\nprint(\"Restoring files from backup...\")\nfor f in files_to_restore:\n    src = os.path.join(BACKUP_PATH, f)\n    dst = f'/kaggle/working/{f}'\n    if os.path.exists(src):\n        shutil.copy(src, dst)\n        print(f\"✅ Restored: {f}\")\n    else:\n        print(f\"⚠️  Not found (ok if optional): {f}\")\n\nprint(\"\\n✅ Recovery Complete!\")\n\n# Verification\nprint(\"\\n--- VERIFICATION ---\")\ncritical_files = ['raw_clean_split.json', 'split_leaked.json', 'class_weights.json', 'model_B_leaked_best.pth']\nall_ok = True\nfor f in critical_files:\n    p = f'/kaggle/working/{f}'\n    if os.path.exists(p):\n        print(f\"✅ {f}\")\n    else:\n        print(f\"❌ MISSING: {f}\")\n        all_ok = False\n\nif all_ok:\n    print(\"\\n🎯 All critical files ready. You can proceed to training.\")\nelse:\n    print(\"\\n⚠️ Some critical files missing. Check BACKUP_PATH.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CONSOLIDATED SETUP + MIXUP/CUTMIX TRAINING (30 Epochs)\n# ============================================================\nimport os, json, math, random, time\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\n\nprint(\"=\"*70)\nprint(\" FINAL SHOWDOWN: SETUP + MIXUP/CUTMIX TRAINING\")\nprint(\"=\"*70)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# 1. Load Data\nwith open('/kaggle/working/raw_clean_split.json') as f:\n    raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open('/kaggle/working/split_leaked.json') as f:\n    leaked_split = json.load(f)\nwith open('/kaggle/working/class_weights.json') as f:\n    cw = json.load(f)\nleaked_dis_w = torch.tensor(cw['leaked']['dis'], dtype=torch.float32).to(device)\nleaked_pest_w = torch.tensor(cw['leaked']['pest'], dtype=torch.float32).to(device)\n\n# 2. Transforms & Dataset\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5), transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(), transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle: random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self): return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\nleaked_train_loader = DataLoader(CCMTDataset(leaked_split['train'], train_tf), batch_sampler=DomainBatchSampler(leaked_split['train'], BATCH_SIZE, True), num_workers=2, pin_memory=True)\nleaked_test_loader = DataLoader(CCMTDataset(leaked_split['test'], val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# 3. Model Architecture\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# 4. Loss, Mixup & Train Functions\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__(); self.alpha = alpha; self.gamma = gamma; self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction='none', label_smoothing=self.ls)\n        pt = torch.exp(-ce); return (((1 - pt) ** self.gamma) * ce).mean()\n\ndef mixup_cutmix_data(x, y, domains, alpha=1.0):\n    if np.random.rand() < 0.5: return x, y, domains\n    batch_size = x.size(0); index = torch.randperm(batch_size).to(x.device)\n    if not (domains == domains[index]).all(): return x, y, domains\n    if np.random.rand() < 0.5:\n        lam = np.random.beta(alpha, alpha); x_mixed = lam * x + (1 - lam) * x[index]\n        return x_mixed, (y, y[index], lam), domains\n    else:\n        lam = np.random.beta(alpha, alpha); bbx1, bby1, bbx2, bby2 = rand_bbox(x.size(), lam)\n        x_mixed = x.clone(); x_mixed[:, :, bbx1:bbx2, bby1:bby2] = x[index, :, bbx1:bbx2, bby1:bby2]\n        lam = 1 - ((bbx2 - bbx1) * (bby2 - bby1) / (x.size()[-1] * x.size()[-2]))\n        return x_mixed, (y, y[index], lam), domains\n\ndef rand_bbox(size, lam):\n    W = size[2]; H = size[3]; cut_rat = np.sqrt(1. - lam)\n    cut_w = int(W * cut_rat); cut_h = int(H * cut_rat)\n    cx = np.random.randint(W); cy = np.random.randint(H)\n    bbx1 = np.clip(cx - cut_w // 2, 0, W); bby1 = np.clip(cy - cut_h // 2, 0, H)\n    bbx2 = np.clip(cx + cut_w // 2, 0, W); bby2 = np.clip(cy + cut_h // 2, 0, H)\n    return bbx1, bby1, bbx2, bby2\n\nGRAD_ACCUM_STEPS = 2; MAX_GRAD_NORM = 1.0; MAX_SANE_LOSS = 30.0\n\ndef train_one_epoch_mixup(model, loader, optimizer, cd, cp, desc=\"Train\"):\n    model.train(); tl, co, to, sk, v = 0.0, 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=desc):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        imgs_mixed, labels_info, _ = mixup_cutmix_data(imgs, labels, domains)\n        is_mixed = isinstance(labels_info, tuple)\n        \n        optimizer.zero_grad()\n        ld, lp = model(imgs_mixed, domains)\n        dm = (domains == 0); pm = (domains == 1); loss = torch.tensor(0.0, device=device)\n        \n        if is_mixed:\n            y_a, y_b, lam = labels_info\n            if dm.any():\n                loss += lam * cd(ld[dm], y_a[dm]) + (1 - lam) * cd(ld[dm], y_b[dm])\n                co += ((ld[dm].argmax(1) == y_a[dm]).sum().item() * lam + (ld[dm].argmax(1) == y_b[dm]).sum().item() * (1-lam))\n                to += dm.sum().item()\n            if pm.any():\n                loss += lam * cp(lp[pm], y_a[pm]) + (1 - lam) * cp(lp[pm], y_b[pm])\n                co += ((lp[pm].argmax(1) == y_a[pm]).sum().item() * lam + (lp[pm].argmax(1) == y_b[pm]).sum().item() * (1-lam))\n                to += pm.sum().item()\n        else:\n            if dm.any():\n                loss += cd(ld[dm], labels[dm]); co += (ld[dm].argmax(1) == labels[dm]).sum().item(); to += dm.sum().item()\n            if pm.any():\n                loss += cp(lp[pm], labels[pm]); co += (lp[pm].argmax(1) == labels[pm]).sum().item(); to += pm.sum().item()\n        \n        if torch.isnan(loss) or torch.isinf(loss) or loss.item() > MAX_SANE_LOSS: sk += 1; continue\n        \n        loss = loss / GRAD_ACCUM_STEPS\n        loss.backward()\n        \n        if (v + 1) % GRAD_ACCUM_STEPS == 0:\n            torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM)\n            optimizer.step(); optimizer.zero_grad()\n            \n        tl += loss.item() * GRAD_ACCUM_STEPS; v += 1\n    return tl/max(1,v), 100*co/max(1,to), sk\n\n@torch.no_grad()\ndef evaluate(model, loader, cd, cp):\n    model.eval(); tl, co, to, v = 0.0, 0, 0, 0; dc, dt, pc, pt = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any(): a = ld[dm]; b = labels[dm]; dc += (a.argmax(1) == b).sum().item(); dt += b.size(0)\n        if pm.any(): a = lp[pm]; b = labels[pm]; pc += (a.argmax(1) == b).sum().item(); pt += b.size(0)\n        to += labels.size(0)\n    return 0.0, 100*(dc+pc)/to, 100*dc/max(1,dt), 100*pc/max(1,pt)\n\n# 5. Run Training\nmodel_final = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nprint(\"✅ Model Initialized from scratch\")\n\ncrit_dis = FocalLoss(alpha=leaked_dis_w, gamma=2.0).to(device)\ncrit_pest = FocalLoss(alpha=leaked_pest_w, gamma=2.0).to(device)\n\nEPOCHS = 30\nLR = 5e-5\noptimizer = optim.AdamW(model_final.parameters(), lr=LR, weight_decay=0.05)\nscheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n\nbest_val = 0; no_improve = 0; PATIENCE = 7\n\nprint(f\"\\n{'='*70}\")\nprint(f\" TRAINING START (30 Epochs, Mixup/CutMix)\")\nprint(f\"{'='*70}\\n\")\n\nfor epoch in range(EPOCHS):\n    start_t = time.time()\n    train_loss, train_acc, skipped = train_one_epoch_mixup(\n        model_final, leaked_train_loader, optimizer, crit_dis, crit_pest, desc=f\"Ep{epoch+1}\"\n    )\n    _, val_acc, dis_acc, pest_acc = evaluate(model_final, leaked_test_loader, crit_dis, crit_pest)\n    scheduler.step()\n    elapsed = time.time() - start_t\n    \n    print(f\"\\n[Ep {epoch+1}/{EPOCHS}] Time: {elapsed/60:.1f}m | Train: {train_acc:.2f}% | Test: {val_acc:.2f}% (Dis: {dis_acc:.2f}% | Pest: {pest_acc:.2f}%)\")\n    \n    torch.save(model_final.state_dict(), f'/kaggle/working/model_final_ep{epoch+1}.pth')\n    \n    if val_acc > best_val:\n        best_val = val_acc; no_improve = 0\n        torch.save(model_final.state_dict(), '/kaggle/working/model_final_best.pth')\n        print(f\" 💾 Saved New Best! (Test: {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\" ⏸️ No improvement ({no_improve}/{PATIENCE})\")\n        if no_improve >= PATIENCE:\n            print(f\"🛑 Early stopping triggered at epoch {epoch+1}\")\n            break\n\nprint(f\"\\n✅ RETRAIN COMPLETE. Best Test Acc: {best_val:.2f}%\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!pip install ninja packaging einops uv\n!pip install --force-reinstall torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu126\n!uv pip install --system --no-deps --index https://wheels.astral.sh/simple/cu126/ \"causal-conv1d==1.6.0+cu12.6torch2.7.1cxx11abitrue\" \"mamba-ssm==2.3.0+cu12.6torch2.7.1cxx11abitrue\"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport glob\nimport ctypes\nimport torch\n\nprint(\"=\"*60)\nprint(\" 🔍 FULL ENVIRONMENT & FILE VERIFICATION\")\nprint(\"=\"*60)\n\n# ১. CUDA লাইব্রেরি প্রিলোড (নিশ্চিত করার জন্য)\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths:\n    ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n    print(\"✅ libcudart.so.12 preloaded successfully.\")\n\n# ২. ফাইল চেক\nprint(\"\\n--- Checking Files ---\")\nif os.path.exists('/kaggle/working/split_clean.json'):\n    print(\"✅ split_clean.json found in /kaggle/working/\")\nelse:\n    print(\"❌ Missing split_clean.json in working dir!\")\n\nAUG_PATH = '/kaggle/input/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nif os.path.exists(AUG_PATH):\n    print(\"✅ Dataset folder found!\")\nelse:\n    print(f\"❌ Dataset not found at: {AUG_PATH}\")\n\nmodel_input = '/kaggle/input/clean-resume-checkpoints/model_clean_ep21.pth'\nif os.path.exists(model_input):\n    print(\"✅ Model (ep21) found in Input!\")\nelse:\n    print(\"❌ Model not found in Input, checking working dir...\")\n    if os.path.exists('/kaggle/working/model_clean_ep21.pth'):\n         print(\"✅ Model found in /kaggle/working/\")\n\n# ৩. PyTorch & CUDA চেক\nprint(\"\\n--- Checking PyTorch & CUDA ---\")\nprint(f\"PyTorch Version: {torch.__version__}\")\nprint(f\"CUDA Available: {torch.cuda.is_available()}\")\nif torch.cuda.is_available():\n    print(f\"GPU Name: {torch.cuda.get_device_name(0)}\")\n\n# ৪. Mamba ইনপোর্ট এবং GPU Forward Pass (Dummy Test)\nprint(\"\\n--- Testing Mamba GPU Forward Pass ---\")\ntry:\n    from mamba_ssm import Mamba\n    \n    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n    # ছোট একটি ডামি Mamba মডেল\n    dummy_mamba = Mamba(\n        d_model=64,\n        d_state=16,\n        d_conv=4,\n        expand=2\n    ).to(device)\n    \n    # ডামি ইনপুট (Batch=2, Seq=128, Dim=64)\n    x = torch.randn(2, 128, 64).to(device)\n    \n    with torch.no_grad():\n        y = dummy_mamba(x)\n        \n    torch.cuda.synchronize()\n    \n    print(f\"✅ Output shape: {y.shape}\")\n    print(f\"✅ Output finite (No NaN/Inf): {torch.isfinite(y).all().item()}\")\n    \n    if torch.isfinite(y).all().item():\n        print(\"\\n🎉 ALL CHECKS PASSED! You are ready to run the training code.\")\n    else:\n        print(\"\\n❌ FORWARD PASS FAILED: Output contains NaN.\")\n        \nexcept Exception as e:\n    print(f\"\\n❌ Mamba Import or Forward Pass Failed: {e}\")\n    print(\"👉 Please reinstall Mamba using the 'uv' command.\")\n\nprint(\"\\n\" + \"=\"*60)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import shutil\nimport os\n\nsrc_dir = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\ndst_dir = '/kaggle/working'\n\nprint(\"Copying JSON files to working directory...\")\nfiles_to_copy = ['raw_clean_split.json', 'split_clean.json', 'class_weights.json', 'split_leaked.json']\n\nfor file in files_to_copy:\n    src = os.path.join(src_dir, file)\n    if os.path.exists(src):\n        shutil.copy(src, dst_dir)\n        print(f\"✅ Copied: {file}\")\n    else:\n        print(f\"❌ Not found: {src}\")\n\nprint(\"\\n✅ Files copied! Now you can run the training code.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, math, random, time\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\nimport ctypes\nimport glob\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths:\n    ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ⚠️ তোমার দেওয়া সঠিক পাথগুলো\nRESULTS_PATH = '/kaggle/working'  \nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented' \nMODEL_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/model_clean_ep21.pth'\nOUTPUT_DIR = '/kaggle/working'\n\n# 1. Load CLEAN Data\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\nwith open(f'{RESULTS_PATH}/class_weights.json') as f: cw = json.load(f)\nclean_dis_w = torch.tensor(cw['clean']['dis'], dtype=torch.float32).to(device)\nclean_pest_w = torch.tensor(cw['clean']['pest'], dtype=torch.float32).to(device)\n\ndef fix_paths(data_list):\n    fixed = []\n    for path, lbl, dom in data_list:\n        if path.startswith('/kaggle/input'):\n            if 'CCMT Dataset-Augmented/' in path:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                new_path = f'{AUG_PATH}/{suffix}'\n            else:\n                new_path = path\n            fixed.append((new_path, lbl, dom))\n        else:\n            fixed.append((path, lbl, dom))\n    return fixed\n\nclean_train_data = fix_paths(clean_split['train'])\nclean_val_data = fix_paths(clean_split['val'])\n\n# 2. Transforms & Dataset\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5), transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(), transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle: random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self): return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\nclean_train_loader = DataLoader(CCMTDataset(clean_train_data, train_tf), batch_sampler=DomainBatchSampler(clean_train_data, BATCH_SIZE, True), num_workers=2, pin_memory=True)\nclean_val_loader = DataLoader(CCMTDataset(clean_val_data, val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# 3. Model Architecture\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# 4. Loss & Train Functions\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2.0, label_smoothing=0.05):\n        super().__init__(); self.alpha = alpha; self.gamma = gamma; self.ls = label_smoothing\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction='none', label_smoothing=self.ls)\n        pt = torch.exp(-ce); return (((1 - pt) ** self.gamma) * ce).mean()\n\nGRAD_ACCUM_STEPS = 2; MAX_GRAD_NORM = 1.0; MAX_SANE_LOSS = 30.0\n\ndef train_one_epoch_standard(model, loader, optimizer, cd, cp, desc=\"Train\"):\n    model.train(); tl, co, to, sk, v = 0.0, 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=desc):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        optimizer.zero_grad()\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1); loss = torch.tensor(0.0, device=device)\n        if dm.any():\n            loss += cd(ld[dm], labels[dm]); co += (ld[dm].argmax(1) == labels[dm]).sum().item(); to += dm.sum().item()\n        if pm.any():\n            loss += cp(lp[pm], labels[pm]); co += (lp[pm].argmax(1) == labels[pm]).sum().item(); to += pm.sum().item()\n        if torch.isnan(loss) or torch.isinf(loss) or loss.item() > MAX_SANE_LOSS: sk += 1; continue\n        loss = loss / GRAD_ACCUM_STEPS\n        loss.backward()\n        if (v + 1) % GRAD_ACCUM_STEPS == 0:\n            torch.nn.utils.clip_grad_norm_(model.parameters(), MAX_GRAD_NORM)\n            optimizer.step(); optimizer.zero_grad()\n        tl += loss.item() * GRAD_ACCUM_STEPS; v += 1\n    return tl/max(1,v), 100*co/max(1,to), sk\n\n@torch.no_grad()\ndef evaluate(model, loader, cd, cp):\n    model.eval(); tl, co, to, v = 0.0, 0, 0, 0; dc, dt, pc, pt = 0, 0, 0, 0\n    for imgs, labels, domains in tqdm(loader, desc=\"Val\", leave=False):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any(): a = ld[dm]; b = labels[dm]; dc += (a.argmax(1) == b).sum().item(); dt += b.size(0)\n        if pm.any(): a = lp[pm]; b = labels[pm]; pc += (a.argmax(1) == b).sum().item(); pt += b.size(0)\n        to += labels.size(0)\n    return 0.0, 100*(dc+pc)/to, 100*dc/max(1,dt), 100*pc/max(1,pt)\n\n# ============================================================\n# 5. RESUME CLEAN TRAINING (Ep 22 to 35)\n# ============================================================\nmodel_clean = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\n\nif not os.path.exists(MODEL_PATH):\n    raise FileNotFoundError(f\"❌ model_clean_ep21.pth not found at {MODEL_PATH}\")\n\nmodel_clean.load_state_dict(torch.load(MODEL_PATH, map_location=device))\nprint(f\"✅ Resumed from {MODEL_PATH}\")\n\ncrit_dis = FocalLoss(alpha=clean_dis_w, gamma=2.0).to(device)\ncrit_pest = FocalLoss(alpha=clean_pest_w, gamma=2.0).to(device)\n\nTOTAL_EPOCHS = 35\nSTART_EPOCH = 21 # Ep 21 শেষ\nLR = 5e-5\n\noptimizer = optim.AdamW(model_clean.parameters(), lr=LR, weight_decay=0.05)\nfor param_group in optimizer.param_groups:\n    param_group['initial_lr'] = LR\n\nscheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=TOTAL_EPOCHS, last_epoch=START_EPOCH - 1)\n\nbest_val = 83.16 # Ep 21-এর বেস্ট\nno_improve = 0; PATIENCE = 10\n\nprint(f\"\\n{'='*70}\")\nprint(f\" RESUMING CLEAN TRAINING: EPOCH {START_EPOCH+1} TO {TOTAL_EPOCHS}\")\nprint(f\"{'='*70}\\n\")\n\nfor epoch in range(START_EPOCH, TOTAL_EPOCHS):\n    start_t = time.time()\n    train_loss, train_acc, skipped = train_one_epoch_standard(\n        model_clean, clean_train_loader, optimizer, crit_dis, crit_pest, desc=f\"Ep{epoch+1}\"\n    )\n    val_loss, val_acc, dis_acc, pest_acc = evaluate(model_clean, clean_val_loader, crit_dis, crit_pest)\n    scheduler.step()\n    elapsed = time.time() - start_t\n    \n    print(f\"\\n[Ep {epoch+1}/{TOTAL_EPOCHS}] Time: {elapsed/60:.1f}m | Train Loss: {train_loss:.4f} Acc: {train_acc:.2f}% | Val Acc: {val_acc:.2f}% (Dis: {dis_acc:.2f}% | Pest: {pest_acc:.2f}%)\")\n    \n    # Kaggle Working-এ সেভ (যাতে Commit দিলে সেভ থাকে)\n    torch.save(model_clean.state_dict(), f'{OUTPUT_DIR}/model_clean_ep{epoch+1}.pth')\n    \n    if val_acc > best_val:\n        best_val = val_acc; no_improve = 0\n        torch.save(model_clean.state_dict(), f'{OUTPUT_DIR}/model_clean_best.pth')\n        print(f\" 💾 Saved New Best! (Val: {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\" ⏸️ No improvement ({no_improve}/{PATIENCE})\")\n        if no_improve >= PATIENCE:\n            print(f\"🛑 Early stopping triggered\")\n            break\n\nprint(f\"\\n✅ CLEAN TRAINING COMPLETE. Best Val Acc: {best_val:.2f}%\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, math, random, time\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\nimport ctypes\nimport glob\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths:\n    ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ⚠️ নিশ্চিত করো পাথগুলো ঠিক আছে\nRESULTS_PATH = '/kaggle/working'  \nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented' \nOUTPUT_DIR = '/kaggle/working'\n\n# 1. Load CLEAN Data\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\nwith open(f'{RESULTS_PATH}/class_weights.json') as f: cw = json.load(f)\nclean_dis_w = torch.tensor(cw['clean']['dis'], dtype=torch.float32).to(device)\nclean_pest_w = torch.tensor(cw['clean']['pest'], dtype=torch.float32).to(device)\n\ndef fix_paths(data_list):\n    fixed = []\n    for path, lbl, dom in data_list:\n        if path.startswith('/kaggle/input'):\n            if 'CCMT Dataset-Augmented/' in path:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                new_path = f'{AUG_PATH}/{suffix}'\n            else:\n                new_path = path\n            fixed.append((new_path, lbl, dom))\n        else:\n            fixed.append((path, lbl, dom))\n    return fixed\n\nclean_train_data = fix_paths(clean_split['train'])\nclean_val_data = fix_paths(clean_split['val'])\n\n# 2. Transforms & Dataset\ntrain_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5), transforms.ColorJitter(0.2, 0.2, 0.2),\n    transforms.ToTensor(), transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclass DomainBatchSampler:\n    def __init__(self, data_list, batch_size, shuffle=True):\n        self.disease_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 0]\n        self.pest_idx = [i for i, (_,_,d) in enumerate(data_list) if d == 1]\n        self.bs = batch_size; self.shuffle = shuffle\n    def __iter__(self):\n        if self.shuffle: random.shuffle(self.disease_idx); random.shuffle(self.pest_idx)\n        db = [self.disease_idx[i:i+self.bs] for i in range(0, len(self.disease_idx), self.bs)]\n        pb = [self.pest_idx[i:i+self.bs] for i in range(0, len(self.pest_idx), self.bs)]\n        allb = []\n        for i in range(max(len(db), len(pb))):\n            if i < len(db): allb.append(db[i])\n            if i < len(pb): allb.append(pb[i])\n        if self.shuffle: random.shuffle(allb)\n        for b in allb: yield b\n    def __len__(self): return math.ceil(len(self.disease_idx)/self.bs) + math.ceil(len(self.pest_idx)/self.bs)\n\nBATCH_SIZE = 8\nclean_train_loader = DataLoader(CCMTDataset(clean_train_data, train_tf), batch_sampler=DomainBatchSampler(clean_train_data, BATCH_SIZE, True), num_workers=2, pin_memory=True)\nclean_val_loader = DataLoader(CCMTDataset(clean_val_data, val_tf), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n\n# 3. Model Architecture\n# [Copy BSM, MultiScalePatchEmbed, BiMambaBlock, CrossAttention, AdaptiveQueryGen, CrossMambaAgriV2 here]\n\n# 4. Loss & Train Functions\n# [Copy FocalLoss, train_one_epoch_standard, evaluate here]\n\n# ============================================================\n# 5. EXTENDED CLEAN FINE-TUNING (Ep 36 to 45, LR=1e-5)\n# ============================================================\nmodel_clean = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\n\n# আগের বেস্ট মডেল (88.55%) লোড করা\nbest_model_path = f'{OUTPUT_DIR}/model_clean_best.pth'\nif not os.path.exists(best_model_path):\n    # যদি Kaggle input থেকে লোড করতে চাও, তবে পাথ চেঞ্জ করো\n    raise FileNotFoundError(\"❌ model_clean_best.pth not found in working dir!\")\n\nmodel_clean.load_state_dict(torch.load(best_model_path, map_location=device))\nprint(f\"✅ Resumed from {best_model_path} (Best Val: 88.55%)\")\n\ncrit_dis = FocalLoss(alpha=clean_dis_w, gamma=2.0).to(device)\ncrit_pest = FocalLoss(alpha=clean_pest_w, gamma=2.0).to(device)\n\n# ⚠️ শুধু ১০ এপক, খুব কম লার্নিং রেট\nTOTAL_EPOCHS = 45 \nSTART_EPOCH = 35 # ৩৫ শেষ, তাই ৩৬ থেকে শুরু হবে\nLR = 1e-5 # ⚠️ লার্নিং রেট কমিয়ে ১e-৫\n\noptimizer = optim.AdamW(model_clean.parameters(), lr=LR, weight_decay=0.05)\nfor param_group in optimizer.param_groups:\n    param_group['initial_lr'] = LR\n\nscheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=(TOTAL_EPOCHS - START_EPOCH), last_epoch=-1)\n\nbest_val = 88.55 # আগের বেস্ট\nno_improve = 0; PATIENCE = 3 # Early Stopping ৩ এপক\n\nprint(f\"\\n{'='*70}\")\nprint(f\" EXTENDED CLEAN FINE-TUNING: EPOCH {START_EPOCH+1} TO {TOTAL_EPOCHS}\")\nprint(f\"{'='*70}\\n\")\n\nfor epoch in range(START_EPOCH, TOTAL_EPOCHS):\n    start_t = time.time()\n    train_loss, train_acc, skipped = train_one_epoch_standard(\n        model_clean, clean_train_loader, optimizer, crit_dis, crit_pest, desc=f\"Ep{epoch+1}\"\n    )\n    val_loss, val_acc, dis_acc, pest_acc = evaluate(model_clean, clean_val_loader, crit_dis, crit_pest)\n    scheduler.step()\n    elapsed = time.time() - start_t\n    \n    print(f\"\\n[Ep {epoch+1}/{TOTAL_EPOCHS}] Time: {elapsed/60:.1f}m | Train Loss: {train_loss:.4f} Acc: {train_acc:.2f}% | Val Acc: {val_acc:.2f}% (Dis: {dis_acc:.2f}% | Pest: {pest_acc:.2f}%)\")\n    \n    if val_acc > best_val:\n        best_val = val_acc; no_improve = 0\n        torch.save(model_clean.state_dict(), f'{OUTPUT_DIR}/model_clean_best.pth')\n        print(f\" 💾 Saved New Best! (Val: {val_acc:.2f}%)\")\n    else:\n        no_improve += 1\n        print(f\" ⏸️ No improvement ({no_improve}/{PATIENCE})\")\n        if no_improve >= PATIENCE:\n            print(f\"🛑 Early stopping triggered\")\n            break\n\nprint(f\"\\n✅ EXTENDED CLEAN TRAINING COMPLETE. Best Val Acc: {best_val:.2f}%\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, math, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nfrom tqdm import tqdm\nimport ctypes\nimport glob\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths:\n    ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\nRESULTS_PATH = '/kaggle/working'  \nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented' \nMODEL_PATH = '/kaggle/working/model_clean_best.pth' \n\n# 1. Load Data (Clean Test Set)\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\ndef fix_paths(data_list):\n    fixed = []\n    for path, lbl, dom in data_list:\n        if path.startswith('/kaggle/input'):\n            if 'CCMT Dataset-Augmented/' in path:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                new_path = f'{AUG_PATH}/{suffix}'\n            else:\n                new_path = path\n            fixed.append((new_path, lbl, dom))\n        else:\n            fixed.append((path, lbl, dom))\n    return fixed\n\nclean_test_data = fix_paths(clean_split['test'])\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nclean_test_loader = DataLoader(CCMTDataset(clean_test_data, val_tf), batch_size=16, shuffle=False, num_workers=2, pin_memory=True)\n\n# 2. Model Architecture\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleL