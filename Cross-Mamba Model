 কপি করে]\n\n# ✅ 1. Model Load\nmodel = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12).to(device)\nmodel.load_state_dict(torch.load(MODEL_CLEAN_PATH, map_location=device))\nmodel.eval()\nprint(\"✅ Clean Model Loaded!\")\n\n# ✅ 2. Get Predictions\nall_preds, all_labels, all_probs = [], [], []\nwith torch.no_grad():\n    for imgs, labels, domains in tqdm(clean_test_loader, desc=\"Getting Predictions\"):\n        imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n        ld, lp = model(imgs, domains)\n        dm = (domains == 0); pm = (domains == 1)\n        if dm.any():\n            probs = F.softmax(ld[dm], dim=1)\n            all_probs.extend(probs.cpu().numpy()); all_preds.extend(probs.argmax(1).cpu().numpy()); all_labels.extend(labels[dm].cpu().numpy())\n        if pm.any():\n            probs = F.softmax(lp[pm], dim=1)\n            all_probs.extend(probs.cpu().numpy()); all_preds.extend(probs.argmax(1).cpu().numpy()); all_labels.extend(labels[pm].cpu().numpy())\n\n# ✅ 3. Classification Report\nprint(\"\\n\" + \"=\"*50)\nprint(\" 📊 CLASSIFICATION REPORT\")\nprint(\"=\"*50)\nprint(classification_report(all_labels, all_preds, zero_division=0))\n\n# ✅ 4. Confusion Matrix\ncm = confusion_matrix(all_labels, all_preds)\nplt.figure(figsize=(12, 10))\nsns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False)\nplt.title('Confusion Matrix - Clean Model (89.20%)')\nplt.xlabel('Predicted Label')\nplt.ylabel('True Label')\nplt.savefig('confusion_matrix_clean.png', dpi=300)\nplt.show()\n\n# ✅ 5. ROC-AUC Curve\ny_true_bin = label_binarize(all_labels, classes=range(17))\ny_score = np.array(all_probs)\nfpr, tpr, _ = roc_curve(y_true_bin.ravel(), y_score.ravel())\nroc_auc = auc(fpr, tpr)\n\nplt.figure(figsize=(8, 6))\nplt.plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC curve (AUC = {roc_auc:.3f})')\nplt.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')\nplt.title('ROC Curve - Clean Model')\nplt.legend(loc=\"lower right\")\nplt.savefig('roc_curve_clean.png', dpi=300)\nplt.show()\n\n# ✅ 6. Grad-CAM (Heatmap)\nclass GradCAM:\n    def __init__(self, model, target_layer):\n        self.model = model; self.target_layer = target_layer\n        self.gradients = None; self.activations = None\n        target_layer.register_forward_hook(self.save_activation)\n        target_layer.register_full_backward_hook(self.save_gradient)\n    def save_activation(self, module, input, output): self.activations = output\n    def save_gradient(self, module, grad_input, grad_output): self.gradients = grad_output[0]\n    def generate(self, input_image, domain):\n        self.model.eval()\n        input_image = input_image.unsqueeze(0).to(device)\n        domain = torch.tensor([domain]).to(device)\n        ld, lp = self.model(input_image, domain)\n        pred_class = ld.argmax(1).item() if domain.item() == 0 else lp.argmax(1).item()\n        score = ld[0, pred_class] if domain.item() == 0 else lp[0, pred_class]\n        self.model.zero_grad(); score.backward()\n        gradients = self.gradients.detach().cpu().numpy()[0]\n        activations = self.activations.detach().cpu().numpy()[0]\n        weights = np.mean(gradients, axis=(1, 2))\n        cam = np.zeros(activations.shape[1:], dtype=np.float32)\n        for i, w in enumerate(weights): cam += w * activations[i]\n        cam = np.maximum(cam, 0); cam = cv2.resize(cam, (224, 224))\n        cam = cam - np.min(cam); cam = cam / (np.max(cam) + 1e-8)\n        return cam\n\n# Grad-CAM Visualization\ngrad_cam = GradCAM(model, model.bsm) # Targeting BSM module\nprint(\"\\nGenerating Grad-CAM Heatmaps...\")\nfor i in range(3):\n    img, label, dom = clean_test_data[i]\n    original_img = Image.open(img).convert('RGB')\n    input_tensor = val_tf(original_img)\n    cam = grad_cam.generate(input_tensor, dom)\n    \n    plt.figure(figsize=(10, 4))\n    plt.subplot(1, 2, 1)\n    plt.imshow(original_img)\n    plt.title('Original Image')\n    plt.axis('off')\n    \n    plt.subplot(1, 2, 2)\n    plt.imshow(original_img)\n    plt.imshow(cam, cmap='jet', alpha=0.5) # Overlay heatmap\n    plt.title('Grad-CAM (Model Focus Area)')\n    plt.axis('off')\n    plt.savefig(f'gradcam_sample_{i}.png', dpi=300)\n    plt.show()\n\nprint(\"\\n✅ All visualizations and metrics generated successfully!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nimport ctypes, glob\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import classification_report, confusion_matrix, roc_curve, auc\nfrom sklearn.preprocessing import label_binarize\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n\n# Paths\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nRAW_BASE_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset'\nMODEL_A_PATH = f'{RESULTS_PATH}/model_A_raw_best.pth'\n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLA