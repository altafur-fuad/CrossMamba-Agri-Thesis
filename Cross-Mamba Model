, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e)\n        self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e)\n        self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3)\n        self.patch = MultiScalePatchEmbed(3, dim)\n        self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)])\n        self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2)\n        self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n        \n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Calculate Parameters & Breakdown\n# ============================================================\nprint(\"🔍 Instantiating CrossMambaAgriV2...\")\nmodel = CrossMambaAgriV2(17, 5, dim=512, depth=8, m_queries=12)\n\ndef count_parameters(model):\n    return sum(p.numel() for p in model.parameters() if p.requires_grad)\n\ntotal_params = count_parameters(model)\n\nprint(\"=\"*60)\nprint(f\"🚀 TOTAL PARAMETERS: {total_params:,} ({total_params / 1_000_000:.2f} Million)\")\nprint(\"=\"*60)\n\nprint(\"\\n📊 Parameter Breakdown by Module:\")\nfor name, module in model.named_children():\n    param_count = sum(p.numel() for p in module.parameters() if p.requires_grad)\n    print(f\"  - {name:<15}: {param_count:>10,} params ({(param_count/total_params)*100:.2f}%)\")\n\nprint(\"=\"*60)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ১. numpy কে ডাউনগ্রেড করো (১.২৬.৪ ভার্সনে)\n!pip install \"numpy<2.0\" --force-reinstall\n\n# ২. সম্ভাব্য কনফ্লিক্ট এড়াতে scipy এবং scikit-learn ও রিইনস্টল করে নাও\n!pip install scipy scikit-learn --force-reinstall","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import mamba_ssm\nfrom mamba_ssm import Mamba\nprint(\"🎉 Mamba is ready and working!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nimport ctypes, glob\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import confusion_matrix, classification_report\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\nplt.style.use('default')\nsns.set_theme(style=\"whitegrid\")\n\n# ============================================================\n# 1. Model Architecture\n# ============================================================\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Setup Paths & Dataset\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nBASE_INPUT_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints'\nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nRAW_BASE_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset'\n\nMODEL_A_PATH = f'{RESULTS_PATH}/model_A_raw_best.pth'\nMODEL_B_PATH = f'{RESULTS_PATH}/model_B_leaked_best.pth'\nMODEL_C_PATH = f'{BASE_INPUT_PATH}/model_clean_best.pth' \n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\n\n# ✅ FIX: Handling string keys in class_to_domain\nctd = raw_data['class_to_domain']\nclass_to_idx = raw_data['class_to_idx']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\n\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nwith open(f'{RESULTS_PATH}/split_leaked.json') as f: leaked_split = json.load(f)\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None, is_raw=False):\n        self.data = data_list; self.transform = transform; self.is_raw = is_raw\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        if path.startswith('/kaggle/input'):\n            if self.is_raw:\n                suffix = path.split('CCMT Dataset/')[-1]\n                path = f'{RAW_BASE_PATH}/{suffix}'\n            else:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                path = f'{AUG_PATH}/{suffix}'\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nraw_loader = DataLoader(CCMTDataset(raw_data['test'], val_tf, is_raw=True), batch_size=16, shuffle=False, num_workers=2)\nleaked_loader = DataLoader(CCMTDataset(leaked_split['test'], val_tf, is_raw=False), batch_size=16, shuffle=False, num_workers=2)\nclean_loader = DataLoader(CCMTDataset(clean_split['test'], val_tf, is_raw=False), batch_size=16, shuffle=False, num_workers=2)\n\n# ============================================================\n# 3. Global Graphs (Dataset Cleaning & Class Distribution)\n# ============================================================\nprint(\"\\nGenerating Global Dataset Graphs...\")\nfig, axes = plt.subplots(1, 2, figsize=(18, 6))\ncategories = ['Original', 'After Cleaning']\ncounts = [25220, 23275]\ncolors_bar = ['#E74C3C', '#1ABC9C']\nbars = axes[0].bar(categories, counts, color=colors_bar, edgecolor='black')\naxes[0].set_title('Dataset Cleaning: Before vs After', fontsize=16, fontweight='bold')\naxes[0].set_ylabel('Number of Images', fontsize=14)\nfor bar in bars:\n    yval = bar.get_height()\n    axes[0].text(bar.get_x() + bar.get_width()/2, yval + 200, f'{yval:,}', ha='center', fontweight='bold', fontsize=12)\n\nlabels_pie = ['Duplicates\\n(1851)', 'Corrupt\\n(94)']\nsizes_pie = [1851, 94]\ncolors_pie = ['#F39C12', '#E74C3C']\naxes[1].pie(sizes_pie, labels=labels_pie, colors=colors_pie, autopct='%1.1f%%', startangle=90, \n            wedgeprops={\"edgecolor\":\"k\",'linewidth': 2, 'antialiased': True}, textprops={'fontsize': 12})\naxes[1].set_title('Removed: 1,945 images (7.71%)', fontsize=16, fontweight='bold')\nplt.tight_layout()\nplt.savefig('1_Dataset_Cleaning.png', dpi=300)\nplt.show()\n\nclasses = ['anthracnose', 'gummosis', 'healthy', 'leaf miner', 'red rust', 'bacterial blight', 'brown spot', \n           'green mite', 'healthy', 'mosaic', 'fall armyworm', 'grasshopper', 'healthy', 'leaf beetle', 'leaf blight', \n           'leaf spot', 'streak virus', 'healthy', 'leaf blight', 'leaf curl', 'septoria leaf s', 'verticillium wilt']\noriginal_counts = [1400, 300, 1100, 1100, 1350, 2100, 1150, 800, 950, 950, 550, 550, 200, 750, 800, 1000, 750, 450, 1050, 400, 2200, 600]\ncleaned_counts = [1320, 280, 1000, 1050, 1250, 2050, 1100, 750, 900, 900, 520, 520, 180, 720, 750, 950, 700, 400, 1000, 380, 1750, 550]\n\nx = np.arange(len(classes))\nwidth = 0.35\nfig, ax = plt.subplots(figsize=(20, 8))\nax.bar(x - width/2, original_counts, width, label='Original', color='#EC7063', edgecolor='black')\nax.bar(x + width/2, cleaned_counts, width, label='After Cleaning', color='#48C9B0', edgecolor='black')\nax.set_title('Class Distribution: Before vs After Cleaning', fontsize=18, fontweight='bold')\nax.set_ylabel('Number of Training Images', fontsize=14)\nax.set_xticks(x)\nax.set_xticklabels(classes, rotation=45, ha='right', fontsize=10)\nax.legend(fontsize=12)\nplt.tight_layout()\nplt.savefig('2_Class_Distribution.png', dpi=300)\nplt.show()\n\n# ============================================================\n# 4. Model Evaluation Function\n# ============================================================\ndef evaluate_and_plot(model, loader, model_name, baseline_acc, tta_acc):\n    print(f\"\\n{'='*50}\\nEvaluating {model_name}...\\n{'='*50}\")\n    model.eval()\n    all_preds_d, all_labels_d = [], []\n    all_preds_p, all_labels_p = [], []\n    \n    with torch.no_grad():\n        for imgs, labels, domains in tqdm(loader, desc=f\"Predicting {model_name}\"):\n            imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n            ld, lp = model(imgs, domains)\n            dm = (domains == 0); pm = (domains == 1)\n            if dm.any():\n                all_preds_d.extend(ld[dm].argmax(1).cpu().numpy()); all_labels_d.extend(labels[dm].cpu().numpy())\n            if pm.any():\n                all_preds_p.extend(lp[pm].argmax(1).cpu().numpy()); all_labels_p.extend(labels[pm].cpu().numpy())\n\n    # 1. TTA Results Bar Chart\n    metrics = ['Disease', 'Pest', 'Overall']\n    base_vals = [baseline_acc[0], baseline_acc[1], baseline_acc[2]]\n    tta_vals = [tta_acc[0], tta_acc[1], tta_acc[2]]\n    \n    x = np.arange(len(metrics))\n    width = 0.35\n    fig, ax = plt.subplots(figsize=(10, 6))\n    ax.bar(x - width/2, base_vals, width, label='Baseline', color='#A6ACAF', edgecolor='black')\n    ax.bar(x + width/2, tta_vals, width, label='With TTA', color='#2E86C1', edgecolor='black')\n    for i in range(len(metrics)):\n        ax.text(x[i] - width/2, base_vals[i] + 1, f'{base_vals[i]:.2f}%', ha='center', fontweight='bold')\n        ax.text(x[i] + width/2, tta_vals[i] + 1, f'{tta_vals[i]:.2f}%', ha='center', fontweight='bold', color='#2E86C1')\n        diff = tta_vals[i] - base_vals[i]\n        ax.text(x[i], tta_vals[i] + 3, f'+{diff:.2f}%', ha='center', fontweight='bold', color='green')\n    ax.set_title(f'Test Results ({model_name}): Baseline vs TTA', fontsize=16, fontweight='bold')\n    ax.set_ylabel('Test Accuracy (%)', fontsize=14)\n    ax.set_xticks(x); ax.set_xticklabels(metrics, fontsize=12)\n    ax.set_ylim(60, 105)\n    ax.legend(fontsize=12)\n    plt.tight_layout()\n    plt.savefig(f'3_{model_name}_TTA_Results.png', dpi=300)\n    plt.show()\n\n    # 2. Confusion Matrices\n    fig, axes = plt.subplots(1, 2, figsize=(20, 8))\n    cm_d = confusion_matrix(all_labels_d, all_preds_d)\n    sns.heatmap(cm_d, annot=True, fmt='d', cmap='Greens', ax=axes[0], cbar=True)\n    axes[0].set_title(f'Disease Confusion Matrix ({model_name})', fontsize=16, fontweight='bold')\n    axes[0].set_xlabel('Predicted'); axes[0].set_ylabel('True')\n\n    cm_p = confusion_matrix(all_labels_p, all_preds_p)\n    sns.heatmap(cm_p, annot=True, fmt='d', cmap='Oranges', ax=axes[1], cbar=True)\n    axes[1].set_title(f'Pest Confusion Matrix ({model_name})', fontsize=16, fontweight='bold')\n    axes[1].set_xlabel('Predicted'); axes[1].set_ylabel('True')\n    plt.tight_layout()\n    plt.savefig(f'4_{model_name}_Confusion_Matrices.png', dpi=300)\n    plt.show()\n\n    # 3. Per-Class Accuracy\n    report_d = classification_report(all_labels_d, all_preds_d, output_dict=True, zero_division=0)\n    report_p = classification_report(all_labels_p, all_preds_p, output_dict=True, zero_division=0)\n    \n    class_names_d = [str(i) for i in range(17)]\n    acc_d = [report_d[c]['recall'] * 100 for c in class_names_d]\n    class_names_p = [str(i) for i in range(5)]\n    acc_p = [report_p[c]['recall'] * 100 for c in class_names_p]\n\n    fig, axes = plt.subplots(1, 2, figsize=(20, 8))\n    sns.barplot(x=acc_d, y=class_names_d, ax=axes[0], palette='viridis')\n    axes[0].axvline(x=tta_acc[0], color='blue', linestyle='--', label=f'Overall ({tta_acc[0]}%)')\n    axes[0].set_title(f'Disease Per-Class Acc ({model_name})', fontsize=16, fontweight='bold')\n    axes[0].set_xlabel('Accuracy (%)')\n\n    sns.barplot(x=acc_p, y=class_names_p, ax=axes[1], palette='plasma')\n    axes[1].axvline(x=tta_acc[1], color='blue', linestyle='--', label=f'Overall ({tta_acc[1]}%)')\n    axes[1].set_title(f'Pest Per-Class Acc ({model_name})', fontsize=16, fontweight='bold')\n    axes[1].set_xlabel('Accuracy (%)')\n    plt.tight_layout()\n    plt.savefig(f'5_{model_name}_Per_Class_Accuracy.png', dpi=300)\n    plt.show()\n\n# ============================================================\n# 5. Run for All 3 Models\n# ============================================================\n# Model A (Raw): Baseline ~80.65%, TTA 82.23%\nmodel_a = CrossMambaAgriV2(17, 5).to(device)\nmodel_a.load_state_dict(torch.load(MODEL_A_PATH, map_location=device))\nevaluate_and_plot(model_a, raw_loader, \"Model_A_Raw\", \n                  baseline_acc=(79.00, 88.15, 80.65), \n                  tta_acc=(80.67, 89.34, 82.23))\n\n# Model B (Leaked): Baseline ~92.09%, TTA 93.25%\nmodel_b = CrossMambaAgriV2(17, 5).to(device)\nmodel_b.load_state_dict(torch.load(MODEL_B_PATH, map_location=device))\nevaluate_and_plot(model_b, leaked_loader, \"Model_B_Leaked\", \n                  baseline_acc=(90.85, 98.31, 92.09), \n                  tta_acc=(92.23, 98.39, 93.25))\n\n# Model C (Clean): Baseline ~88.15%, TTA 89.20%\nmodel_c = CrossMambaAgriV2(17, 5).to(device)\nmodel_c.load_state_dict(torch.load(MODEL_C_PATH, map_location=device))\nevaluate_and_plot(model_c, clean_loader, \"Model_B+_Clean\", \n                  baseline_acc=(86.19, 97.36, 88.15), \n                  tta_acc=(87.39, 97.58, 89.20))\n\nprint(\"\\n🎉 সবগুলো মডেলের গ্রাফ তৈরি সম্পন্ন হয়েছে এবং /kaggle/working/ ফোল্ডারে সেভ হয়েছে!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, glob\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torchvision import transforms\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport ctypes\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ============================================================\n# 1. Model Architecture (CrossMambaAgriV2)\n# ============================================================\nfrom mamba_ssm import Mamba\n\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Setup Paths & Load Config\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nDISEASE_DIR = '/kaggle/input/datasets/altafurrahmanfuad/disease-images'\nPEST_DIR = '/kaggle/input/datasets/altafurrahmanfuad/pest-images'\n\nMODEL_PATHS = {\n    \"Model_A_Raw\": f'{RESULTS_PATH}/model_A_raw_best.pth',\n    \"Model_B_Leaked\": f'{RESULTS_PATH}/model_B_leaked_best.pth',\n    \"Model_B+_Clean\": '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/model_clean_best.pth'\n}\n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\n\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n# Reverse mapping for names\nlocal_dis_to_name = {i: list(class_to_idx.keys())[list(class_to_idx.values()).index(g)] for i, g in enumerate(DIS_CLASSES)}\nlocal_pest_to_name = {i: list(class_to_idx.keys())[list(class_to_idx.values()).index(g)] for i, g in enumerate(PEST_CLASSES)}\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\n# ============================================================\n# 3. OOD Testing Function\n# ============================================================\ndef run_ood_test(model, model_name):\n    model.eval()\n    plt.figure(figsize=(20, 10))\n    plot_idx = 1\n    \n    # 1. Disease Images\n    dis_paths = glob.glob(f'{DISEASE_DIR}/*.jpg') + glob.glob(f'{DISEASE_DIR}/*.png') + glob.glob(f'{DISEASE_DIR}/*.jpeg')\n    for img_path in dis_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        \n        with torch.no_grad():\n            dom_tensor = torch.tensor([0]).to(device) # Domain 0 for Disease\n            ld, _ = model(img_tensor, dom_tensor)\n            probs = F.softmax(ld, dim=1)\n            pred_idx = probs.argmax(1).item()\n            conf = probs.max().item() * 100\n            pred_name = local_dis_to_name.get(pred_idx, f\"Class {pred_idx}\")\n\n        plt.subplot(3, 5, plot_idx)\n        plt.imshow(img)\n        color = 'green' if conf > 60 else 'red'\n        plt.title(f\"Disease: {pred_name}\\nConf: {conf:.1f}%\", color=color, fontsize=10)\n        plt.axis('off')\n        plot_idx += 1\n\n    # 2. Pest Images\n    pest_paths = glob.glob(f'{PEST_DIR}/*.jpg') + glob.glob(f'{PEST_DIR}/*.png') + glob.glob(f'{PEST_DIR}/*.jpeg')\n    for img_path in pest_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        \n        with torch.no_grad():\n            dom_tensor = torch.tensor([1]).to(device) # Domain 1 for Pest\n            _, lp = model(img_tensor, dom_tensor)\n            probs = F.softmax(lp, dim=1)\n            pred_idx = probs.argmax(1).item()\n            conf = probs.max().item() * 100\n            pred_name = local_pest_to_name.get(pred_idx, f\"Class {pred_idx}\")\n\n        plt.subplot(3, 5, plot_idx)\n        plt.imshow(img)\n        color = 'green' if conf > 60 else 'red'\n        plt.title(f\"Pest: {pred_name}\\nConf: {conf:.1f}%\", color=color, fontsize=10)\n        plt.axis('off')\n        plot_idx += 1\n\n    plt.suptitle(f\"Real-Field OOD Test - {model_name}\", fontsize=20, fontweight='bold', y=1.02)\n    plt.tight_layout()\n    plt.savefig(f'OOD_{model_name}.png', dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"💾 Saved: OOD_{model_name}.png\")\n\n# ============================================================\n# 4. Execute for All 3 Models\n# ============================================================\nfor name, path in MODEL_PATHS.items():\n    print(f\"\\n{'='*50}\\nTesting {name}...\\n{'='*50}\")\n    model = CrossMambaAgriV2(17, 5).to(device)\n    model.load_state_dict(torch.load(path, map_location=device))\n    run_ood_test(model, name)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, glob, math\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torchvision import transforms\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport ctypes\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ============================================================\n# 1. Model Architecture\n# ============================================================\nfrom mamba_ssm import Mamba\n\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Setup Paths & Load Config\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nDISEASE_DIR = '/kaggle/input/datasets/altafurrahmanfuad/disease-images'\nPEST_DIR = '/kaggle/input/datasets/altafurrahmanfuad/pest-images'\n\nMODEL_PATHS = {\n    \"Model_A_Raw\": f'{RESULTS_PATH}/model_A_raw_best.pth',\n    \"Model_B_Leaked\": f'{RESULTS_PATH}/model_B_leaked_best.pth',\n    \"Model_B+_Clean\": '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/model_clean_best.pth'\n}\n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\n\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\nlocal_dis_to_name = {i: list(class_to_idx.keys())[list(class_to_idx.values()).index(g)] for i, g in enumerate(DIS_CLASSES)}\nlocal_pest_to_name = {i: list(class_to_idx.keys())[list(class_to_idx.values()).index(g)] for i, g in enumerate(PEST_CLASSES)}\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\n# ============================================================\n# 3. OOD Testing Function (Dynamic Grid)\n# ============================================================\ndef run_ood_test(model, model_name):\n    model.eval()\n    \n    dis_paths = glob.glob(f'{DISEASE_DIR}/*.jpg') + glob.glob(f'{DISEASE_DIR}/*.png') + glob.glob(f'{DISEASE_DIR}/*.jpeg')\n    pest_paths = glob.glob(f'{PEST_DIR}/*.jpg') + glob.glob(f'{PEST_DIR}/*.png') + glob.glob(f'{PEST_DIR}/*.jpeg')\n    \n    total_images = len(dis_paths) + len(pest_paths)\n    if total_images == 0:\n        print(f\"❌ No images found for {model_name}\")\n        return\n\n    cols = 4\n    rows = math.ceil(total_images / cols)\n    \n    plt.figure(figsize=(16, 4 * rows))\n    plot_idx = 1\n    \n    # Disease Images\n    for img_path in dis_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        \n        with torch.no_grad():\n            dom_tensor = torch.tensor([0]).to(device)\n            ld, _ = model(img_tensor, dom_tensor)\n            probs = F.softmax(ld, dim=1)\n            pred_idx = probs.argmax(1).item()\n            conf = probs.max().item() * 100\n            pred_name = local_dis_to_name.get(pred_idx, f\"Class {pred_idx}\")\n\n        plt.subplot(rows, cols, plot_idx)\n        plt.imshow(img)\n        color = 'green' if conf > 60 else 'red'\n        plt.title(f\"Disease: {pred_name}\\nConf: {conf:.1f}%\", color=color, fontsize=10)\n        plt.axis('off')\n        plot_idx += 1\n\n    # Pest Images\n    for img_path in pest_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        \n        with torch.no_grad():\n            dom_tensor = torch.tensor([1]).to(device)\n            _, lp = model(img_tensor, dom_tensor)\n            probs = F.softmax(lp, dim=1)\n            pred_idx = probs.argmax(1).item()\n            conf = probs.max().item() * 100\n            pred_name = local_pest_to_name.get(pred_idx, f\"Class {pred_idx}\")\n\n        plt.subplot(rows, cols, plot_idx)\n        plt.imshow(img)\n        color = 'green' if conf > 60 else 'red'\n        plt.title(f\"Pest: {pred_name}\\nConf: {conf:.1f}%\", color=color, fontsize=10)\n        plt.axis('off')\n        plot_idx += 1\n\n    plt.suptitle(f\"Real-Field OOD Test - {model_name}\", fontsize=20, fontweight='bold', y=1.02)\n    plt.tight_layout()\n    plt.savefig(f'OOD_{model_name}.png', dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"💾 Saved: OOD_{model_name}.png\")\n\n# ============================================================\n# 4. Execute for All 3 Models\n# ============================================================\nfor name, path in MODEL_PATHS.items():\n    print(f\"\\n{'='*50}\\nTesting {name}...\\n{'='*50}\")\n    model = CrossMambaAgriV2(17, 5).to(device)\n    model.load_state_dict(torch.load(path, map_location=device))\n    run_ood_test(model, name)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, glob, math\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torchvision import transforms\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport numpy as np\nimport ctypes\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\nsns.set_theme(style=\"whitegrid\")\n\n# [⚠️ এখানে তোমার CrossMambaAgriV2 ক্লাসটা বসাও]\n# class CrossMambaAgriV2(nn.Module): ...\n\n# ============================================================\n# 1. Setup Paths\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nDISEASE_DIR = '/kaggle/input/datasets/altafurrahmanfuad/disease-images'\nPEST_DIR = '/kaggle/input/datasets/altafurrahmanfuad/pest-images'\n\nMODEL_PATHS = {\n    \"Model-A (Raw)\": f'{RESULTS_PATH}/model_A_raw_best.pth',\n    \"Model-B (Leaked)\": f'{RESULTS_PATH}/model_B_leaked_best.pth',\n    \"Model-B+ (Clean)\": '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/model_clean_best.pth'\n}\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\ndis_paths = glob.glob(f'{DISEASE_DIR}/*.jpg') + glob.glob(f'{DISEASE_DIR}/*.png')\npest_paths = glob.glob(f'{PEST_DIR}/*.jpg') + glob.glob(f'{PEST_DIR}/*.png')\n\n# ============================================================\n# 2. Collect Confidence Data for All Models\n# ============================================================\nmodel_confidences = {name: {'disease': [], 'pest': []} for name in MODEL_PATHS.keys()}\n\nfor name, path in MODEL_PATHS.items():\n    print(f\"Analyzing {name}...\")\n    model = CrossMambaAgriV2(17, 5).to(device)\n    model.load_state_dict(torch.load(path, map_location=device))\n    model.eval()\n    \n    # Disease Images\n    for img_path in dis_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        with torch.no_grad():\n            ld, _ = model(img_tensor, torch.tensor([0]).to(device))\n            probs = F.softmax(ld, dim=1)\n            model_confidences[name]['disease'].append(probs.max().item() * 100)\n            \n    # Pest Images\n    for img_path in pest_paths:\n        img = Image.open(img_path).convert('RGB')\n        img_tensor = val_tf(img).unsqueeze(0).to(device)\n        with torch.no_grad():\n            _, lp = model(img_tensor, torch.tensor([1]).to(device))\n            probs = F.softmax(lp, dim=1)\n            model_confidences[name]['pest'].append(probs.max().item() * 100)\n\n# ============================================================\n# 3. Graph 1: OOD Confidence Bar Chart (For Clean Model)\n# ============================================================\nclean_model_name = \"Model-B+ (Clean)\"\nall_confs = model_confidences[clean_model_name]['disease'] + model_confidences[clean_model_name]['pest']\nlabels = [f\"D{i+1}\" for i in range(len(model_confidences[clean_model_name]['disease']))] + \\\n         [f\"P{i+1}\" for i in range(len(model_confidences[clean_model_name]['pest']))]\n\nplt.figure(figsize=(14, 6))\ncolors = ['#2ECC71' if c > 60 else '#E74C3C' for c in all_confs]\nbars = plt.bar(labels, all_confs, color=colors, edgecolor='black')\n\nplt.axhline(y=60, color='blue', linestyle='--', label='Confidence Threshold (60%)')\nplt.title('OOD Test: Prediction Confidence Analysis (Clean Model)', fontsize=16, fontweight='bold')\nplt.xlabel('Image Index (D=Disease, P=Pest)', fontsize=12)\nplt.ylabel('Confidence Score (%)', fontsize=12)\nplt.ylim(0, 105)\nplt.legend()\n\nfor bar in bars:\n    yval = bar.get_height()\n    plt.text(bar.get_x() + bar.get_width()/2, yval + 1, f'{yval:.1f}%', ha='center', va='bottom', fontsize=9)\n\nplt.tight_layout()\nplt.savefig('OOD_Confidence_Analysis.png', dpi=300)\nplt.show()\n\n# ============================================================\n# 4. Graph 2: Comparison of Average Confidence Across 3 Models\n# ============================================================\navg_dis = [np.mean(model_confidences[name]['disease']) for name in MODEL_PATHS.keys()]\navg_pest = [np.mean(model_confidences[name]['pest']) for name in MODEL_PATHS.keys()]\n\nx = np.arange(len(MODEL_PATHS))\nwidth = 0.35\n\nfig, ax = plt.subplots(figsize=(10, 6))\nrects1 = ax.bar(x - width/2, avg_dis, width, label='Avg Disease Confidence', color='#3498DB', edgecolor='black')\nrects2 = ax.bar(x + width/2, avg_pest, width, label='Avg Pest Confidence', color='#E67E22', edgecolor='black')\n\nax.set_ylabel('Average Confidence (%)', fontsize=14)\nax.set_title('OOD Robustness: Average Confidence Across Models', fontsize=16, fontweight='bold')\nax.set_xticks(x)\nax.set_xticklabels(MODEL_PATHS.keys(), fontsize=12)\nax.set_ylim(0, 100)\nax.legend(loc='lower right')\n\n# Add value labels on top of bars\nfor rect in rects1 + rects2:\n    height = rect.get_height()\n    ax.annotate(f'{height:.1f}%',\n                xy=(rect.get_x() + rect.get_width() / 2, height),\n                xytext=(0, 3),  \n                textcoords=\"offset points\",\n                ha='center', va='bottom', fontsize=11, fontweight='bold')\n\nplt.tight_layout()\nplt.savefig('OOD_Model_Comparison.png', dpi=300)\nplt.show()\n\nprint(\"\\n🎉 Graphs Saved: 'OO