Model-A (Raw)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# (সেল ১-এর ইম্পোর্ট এবং ক্লাসগুলো মেমোরিতে থাকলে সরাসরি এটা রান করো)\n\nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nMODEL_B_PATH = f'{RESULTS_PATH}/model_B_leaked_best.pth'\n\nwith open(f'{RESULTS_PATH}/split_leaked.json') as f: leaked_split = json.load(f)\n\nclass CCMTDatasetLeaked(Dataset):\n    def __init__(self, data_list, transform=None):\n        self.data = data_list; self.transform = transform\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        if path.startswith('/kaggle/input'):\n            suffix = path.split('CCMT Dataset-Augmented/')[-1]\n            path = f'{AUG_PATH}/{suffix}'\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\n# Run Model-B\nmodel_b = CrossMambaAgriV2(17, 5).to(device)\nmodel_b.load_state_dict(torch.load(MODEL_B_PATH, map_location=device))\nleaked_loader = DataLoader(CCMTDatasetLeaked(leaked_split['test'], val_tf), batch_size=16, shuffle=False, num_workers=2)\nevaluate_full(model_b, leaked_loader, \"Model-B (Leaked)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# (সেল ১-এর ইম্পোর্ট এবং ক্লাসগুলো মেমোরিতে থাকলে সরাসরি এটা রান করো)\n\nMODEL_CLEAN_PATH = '/kaggle/working/model_clean_best.pth'\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\n# Run Model-B+ (Clean)\nmodel_c = CrossMambaAgriV2(17, 5).to(device)\nmodel_c.load_state_dict(torch.load(MODEL_CLEAN_PATH, map_location=device))\nclean_loader = DataLoader(CCMTDatasetLeaked(clean_split['test'], val_tf), batch_size=16, shuffle=False, num_workers=2)\nevaluate_full(model_c, clean_loader, \"Model-B+ (Clean)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nimport ctypes, glob\nimport matplotlib.pyplot as plt\nimport cv2\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# Paths\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nRAW_BASE_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset'\n\nMODEL_A_PATH = f'{RESULTS_PATH}/model_A_raw_best.pth'\nMODEL_B_PATH = f'{RESULTS_PATH}/model_B_leaked_best.pth'\nMODEL_CLEAN_PATH = '/kaggle/working/model_clean_best.pth' \n\n# Class mapping\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\n# Reverse mapping for plotting names\nidx_to_dis_name = {v: k for k, v in class_to_idx.items() if k in [k for k,v in class_to_idx.items()]}\nidx_to_pest_name = {v: k for k, v in class_to_idx.items() if k in [k for k,v in class_to_idx.items()]}\n\n# Model Architecture \n# [⚠️ এখানে তোমার CrossMambaAgriV2 এবং অন্যান্য ক্লাসগুলো বসিয়ে নাও, যা আগের সেলে ছিল]\n# class BSM(nn.Module): ...\n# class CrossMambaAgriV2(nn.Module): ...\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\n# ============================================================\n# 1. Prediction Visualization Function\n# ============================================================\ndef plot_predictions(model, dataset, model_name, num_images=8):\n    model.eval()\n    plt.figure(figsize=(16, 8))\n    \n    indices = random.sample(range(len(dataset)), num_images)\n    \n    for i, idx in enumerate(indices):\n        img_tensor, true_label, domain = dataset[idx]\n        original_img = Image.open(dataset.data[idx][0]).convert('RGB')\n        \n        # Predict\n        with torch.no_grad():\n            input_tensor = img_tensor.unsqueeze(0).to(device)\n            dom_tensor = torch.tensor([domain]).to(device)\n            ld, lp = model(input_tensor, dom_tensor)\n            \n            if domain == 0:\n                probs = F.softmax(ld, dim=1)\n                pred_label = probs.argmax(1).item()\n                conf = probs.max().item() * 100\n                class_name = list(class_to_idx.keys())[list(class_to_idx.values()).index(DIS_CLASSES[pred_label])]\n                true_name = list(class_to_idx.keys())[list(class_to_idx.values()).index(DIS_CLASSES[true_label])]\n            else:\n                probs = F.softmax(lp, dim=1)\n                pred_label = probs.argmax(1).item()\n                conf = probs.max().item() * 100\n                class_name = list(class_to_idx.keys())[list(class_to_idx.values()).index(PEST_CLASSES[pred_label])]\n                true_name = list(class_to_idx.keys())[list(class_to_idx.values()).index(PEST_CLASSES[true_label])]\n\n        is_correct = (pred_label == true_label)\n        title_color = 'green' if is_correct else 'red'\n        \n        plt.subplot(2, 4, i + 1)\n        plt.imshow(original_img)\n        plt.title(f\"True: {true_name}\\nPred: {class_name} ({conf:.1f}%)\", color=title_color, fontsize=10)\n        plt.axis('off')\n        \n    plt.suptitle(f\"Sample Predictions - {model_name}\", fontsize=16, fontweight='bold')\n    plt.tight_layout()\n    plt.show()\n\n# ============================================================\n# 2. Grad-CAM Function\n# ============================================================\nclass GradCAM:\n    def __init__(self, model, target_layer):\n        self.model = model\n        self.target_layer = target_layer\n        self.gradients = None\n        self.activations = None\n        target_layer.register_forward_hook(self.save_activation)\n        target_layer.register_full_backward_hook(self.save_gradient)\n        \n    def save_activation(self, module, input, output):\n        self.activations = output\n        \n    def save_gradient(self, module, grad_input, grad_output):\n        self.gradients = grad_output[0]\n        \n    def generate(self, input_image, domain):\n        self.model.eval()\n        input_image = input_image.unsqueeze(0).to(device)\n        domain = torch.tensor([domain]).to(device)\n        \n        # Forward\n        ld, lp = self.model(input_image, domain)\n        \n        if domain.item() == 0:\n            pred_class = ld.argmax(1).item()\n            score = ld[0, pred_class]\n        else:\n            pred_class = lp.argmax(1).item()\n            score = lp[0, pred_class]\n            \n        # Backward\n        self.model.zero_grad()\n        score.backward()\n        \n        # Compute CAM\n        gradients = self.gradients.detach().cpu().numpy()[0]\n        activations = self.activations.detach().cpu().numpy()[0]\n        weights = np.mean(gradients, axis=(1, 2))\n        \n        cam = np.zeros(activations.shape[1:], dtype=np.float32)\n        for i, w in enumerate(weights):\n            cam += w * activations[i]\n            \n        cam = np.maximum(cam, 0)\n        cam = cv2.resize(cam, (224, 224))\n        cam = cam - np.min(cam)\n        cam = cam / (np.max(cam) + 1e-8)\n        return cam\n\ndef plot_gradcam(model, dataset, model_name, num_images=3):\n    # Targeting patch8 (Conv layer inside MultiScalePatchEmbed)\n    grad_cam = GradCAM(model, model.patch.patch8)\n    \n    indices = random.sample(range(len(dataset)), num_images)\n    plt.figure(figsize=(15, 4))\n    \n    for i, idx in enumerate(indices):\n        img_tensor, true_label, domain = dataset[idx]\n        original_img = Image.open(dataset.data[idx][0]).convert('RGB')\n        \n        cam = grad_cam.generate(img_tensor, domain)\n        \n        plt.subplot(1, 3, i + 1)\n        plt.imshow(original_img)\n        plt.imshow(cam, cmap='jet', alpha=0.5)\n        plt.title(f\"Grad-CAM - {model_name}\", fontsize=10)\n        plt.axis('off')\n        \n    plt.tight_layout()\n    plt.show()\n\n# ============================================================\n# 3. Data Loaders Setup\n# ============================================================\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None, is_raw=False):\n        self.data = data_list; self.transform = transform; self.is_raw = is_raw\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        if path.startswith('/kaggle/input'):\n            if self.is_raw:\n                suffix = path.split('CCMT Dataset/')[-1]\n                path = f'{RAW_BASE_PATH}/{suffix}'\n            else:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                path = f'{AUG_PATH}/{suffix}'\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nwith open(f'{RESULTS_PATH}/split_leaked.json') as f: leaked_split = json.load(f)\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\nraw_dataset = CCMTDataset(raw_data['test'], val_tf, is_raw=True)\nleaked_dataset = CCMTDataset(leaked_split['test'], val_tf, is_raw=False)\nclean_dataset = CCMTDataset(clean_split['test'], val_tf, is_raw=False)\n\n# ============================================================\n# 4. Execute Visualizations for All 3 Models\n# ============================================================\n\n# --- Model A ---\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-A (RAW)\")\nprint(\"=\"*50)\nmodel_a = CrossMambaAgriV2(17, 5).to(device)\nmodel_a.load_state_dict(torch.load(MODEL_A_PATH, map_location=device))\nplot_predictions(model_a, raw_dataset, \"Model-A (Raw)\")\nplot_gradcam(model_a, raw_dataset, \"Model-A (Raw)\")\n\n# --- Model B ---\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-B (LEAKED)\")\nprint(\"=\"*50)\nmodel_b = CrossMambaAgriV2(17, 5).to(device)\nmodel_b.load_state_dict(torch.load(MODEL_B_PATH, map_location=device))\nplot_predictions(model_b, leaked_dataset, \"Model-B (Leaked)\")\nplot_gradcam(model_b, leaked_dataset, \"Model-B (Leaked)\")\n\n# --- Model B+ (Clean) ---\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-B+ (CLEAN)\")\nprint(\"=\"*50)\nmodel_c = CrossMambaAgriV2(17, 5).to(device)\nmodel_c.load_state_dict(torch.load(MODEL_CLEAN_PATH, map_location=device))\nplot_predictions(model_c, clean_dataset, \"Model-B+ (Clean)\")\nplot_gradcam(model_c, clean_dataset, \"Model-B+ (Clean)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nimport ctypes, glob\nimport matplotlib.pyplot as plt\nimport cv2\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ============================================================\n# 1. Model Architecture (CrossMambaAgriV2)\n# ============================================================\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Data Loading & Configuration\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nRAW_BASE_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset'\n\nMODEL_A_PATH = f'{RESULTS_PATH}/model_A_raw_best.pth'\nMODEL_B_PATH = f'{RESULTS_PATH}/model_B_leaked_best.pth'\nMODEL_CLEAN_PATH = '/kaggle/working/model_clean_best.pth' \n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nidx_to_name = {v: k for k, v in class_to_idx.items()}\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\ndef unnormalize(tensor):\n    mean = np.array([0.485, 0.456, 0.406])\n    std = np.array([0.229, 0.224, 0.225])\n    img = tensor.cpu().numpy().transpose((1, 2, 0))\n    img = std * img + mean\n    img = np.clip(img, 0, 1)\n    return img\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None, is_raw=False):\n        self.data = data_list; self.transform = transform; self.is_raw = is_raw\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        if path.startswith('/kaggle/input'):\n            if self.is_raw:\n                suffix = path.split('CCMT Dataset/')[-1]\n                path = f'{RAW_BASE_PATH}/{suffix}'\n            else:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                path = f'{AUG_PATH}/{suffix}'\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nwith open(f'{RESULTS_PATH}/split_leaked.json') as f: leaked_split = json.load(f)\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\nraw_dataset = CCMTDataset(raw_data['test'], val_tf, is_raw=True)\nleaked_dataset = CCMTDataset(leaked_split['test'], val_tf, is_raw=False)\nclean_dataset = CCMTDataset(clean_split['test'], val_tf, is_raw=False)\n\n# ============================================================\n# 3. Visualization Functions (Updated to SAVE images automatically)\n# ============================================================\ndef plot_predictions(model, dataset, model_name, num_images=8):\n    model.eval()\n    plt.figure(figsize=(16, 8))\n    indices = random.sample(range(len(dataset)), num_images)\n    \n    for i, idx in enumerate(indices):\n        img_tensor, true_label, domain = dataset[idx]\n        display_img = unnormalize(img_tensor)\n        \n        with torch.no_grad():\n            input_tensor = img_tensor.unsqueeze(0).to(device)\n            dom_tensor = torch.tensor([domain]).to(device)\n            ld, lp = model(input_tensor, dom_tensor)\n            \n            if domain == 0:\n                probs = F.softmax(ld, dim=1)\n                pred_label = probs.argmax(1).item()\n                conf = probs.max().item() * 100\n                true_name = idx_to_name[DIS_CLASSES[true_label]]\n                pred_name = idx_to_name[DIS_CLASSES[pred_label]]\n            else:\n                probs = F.softmax(lp, dim=1)\n                pred_label = probs.argmax(1).item()\n                conf = probs.max().item() * 100\n                true_name = idx_to_name[PEST_CLASSES[true_label]]\n                pred_name = idx_to_name[PEST_CLASSES[pred_label]]\n\n        is_correct = (pred_label == true_label)\n        title_color = 'green' if is_correct else 'red'\n        \n        plt.subplot(2, 4, i + 1)\n        plt.imshow(display_img)\n        plt.title(f\"True: {true_name}\\nPred: {pred_name} ({conf:.1f}%)\", color=title_color, fontsize=10)\n        plt.axis('off')\n        \n    plt.suptitle(f\"Sample Predictions - {model_name}\", fontsize=16, fontweight='bold')\n    plt.tight_layout()\n    \n    # অটোমেটিক সেভ হওয়ার কোড\n    filename = f\"{model_name.replace(' ', '_').replace('(', '').replace(')', '')}_predictions.png\"\n    plt.savefig(filename, dpi=300, bbox_inches='tight')\n    print(f\"💾 Saved: {filename}\")\n    \n    plt.show()\n\nclass GradCAM:\n    def __init__(self, model, target_layer):\n        self.model = model; self.target_layer = target_layer\n        self.gradients = None; self.activations = None\n        target_layer.register_forward_hook(self.save_activation)\n        target_layer.register_full_backward_hook(self.save_gradient)\n    def save_activation(self, module, input, output): self.activations = output\n    def save_gradient(self, module, grad_input, grad_output): self.gradients = grad_output[0]\n    def generate(self, input_image, domain):\n        self.model.eval()\n        input_image = input_image.unsqueeze(0).to(device)\n        domain = torch.tensor([domain]).to(device)\n        \n        ld, lp = self.model(input_image, domain)\n        if domain.item() == 0:\n            pred_class = ld.argmax(1).item(); score = ld[0, pred_class]\n        else:\n            pred_class = lp.argmax(1).item(); score = lp[0, pred_class]\n            \n        self.model.zero_grad(); score.backward()\n        gradients = self.gradients.detach().cpu().numpy()[0]\n        activations = self.activations.detach().cpu().numpy()[0]\n        \n        weights = np.mean(gradients, axis=(1, 2))\n        cam = np.zeros(activations.shape[1:], dtype=np.float32)\n        for i, w in enumerate(weights): cam += w * activations[i]\n            \n        cam = np.maximum(cam, 0)\n        cam = cv2.resize(cam, (224, 224))\n        cam = cam - np.min(cam); cam = cam / (np.max(cam) + 1e-8)\n        return cam\n\ndef plot_gradcam(model, dataset, model_name, num_images=3):\n    grad_cam = GradCAM(model, model.patch.patch8)\n    indices = random.sample(range(len(dataset)), num_images)\n    plt.figure(figsize=(15, 4))\n    \n    for i, idx in enumerate(indices):\n        img_tensor, true_label, domain = dataset[idx]\n        display_img = unnormalize(img_tensor)\n        cam = grad_cam.generate(img_tensor, domain)\n        \n        plt.subplot(1, 3, i + 1)\n        plt.imshow(display_img)\n        plt.imshow(cam, cmap='jet', alpha=0.5)\n        plt.title(f\"Grad-CAM - {model_name}\", fontsize=10)\n        plt.axis('off')\n        \n    plt.tight_layout()\n    \n    # অটোমেটিক সেভ হওয়ার কোড\n    filename = f\"{model_name.replace(' ', '_').replace('(', '').replace(')', '')}_gradcam.png\"\n    plt.savefig(filename, dpi=300, bbox_inches='tight')\n    print(f\"💾 Saved: {filename}\")\n    \n    plt.show()\n\n# ============================================================\n# 4. Execution for All 3 Models\n# ============================================================\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-A (RAW)\")\nprint(\"=\"*50)\nmodel_a = CrossMambaAgriV2(17, 5).to(device)\nmodel_a.load_state_dict(torch.load(MODEL_A_PATH, map_location=device))\nplot_predictions(model_a, raw_dataset, \"Model-A (Raw)\")\nplot_gradcam(model_a, raw_dataset, \"Model-A (Raw)\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-B (LEAKED)\")\nprint(\"=\"*50)\nmodel_b = CrossMambaAgriV2(17, 5).to(device)\nmodel_b.load_state_dict(torch.load(MODEL_B_PATH, map_location=device))\nplot_predictions(model_b, leaked_dataset, \"Model-B (Leaked)\")\nplot_gradcam(model_b, leaked_dataset, \"Model-B (Leaked)\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\" 🖼️ VISUALIZATIONS FOR MODEL-B+ (CLEAN)\")\nprint(\"=\"*50)\nmodel_c = CrossMambaAgriV2(17, 5).to(device)\nmodel_c.load_state_dict(torch.load(MODEL_CLEAN_PATH, map_location=device))\nplot_predictions(model_c, clean_dataset, \"Model-B+ (Clean)\")\nplot_gradcam(model_c, clean_dataset, \"Model-B+ (Clean)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms\nfrom mamba_ssm import Mamba\nimport ctypes, glob\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import classification_report, confusion_matrix, roc_curve, auc\nfrom sklearn.preprocessing import label_binarize\n\n# ✅ libcudart.so.12 প্রিলোড\npossible_paths = glob.glob('/usr/local/lib/python3*/dist-packages/nvidia/cuda_runtime/lib/libcudart.so.12*')\nif possible_paths: ctypes.CDLL(possible_paths[0], mode=ctypes.RTLD_GLOBAL)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"✅ Device: {device}\")\n\n# ============================================================\n# 1. Model Architecture (CrossMambaAgriV2)\n# ============================================================\nclass BSM(nn.Module):\n    def __init__(self, ch=3):\n        super().__init__(); self.sc = nn.Conv2d(ch, ch, 3, padding=1)\n        self.fm = nn.Sequential(nn.Linear(ch, max(ch//2, 4)), nn.ReLU(inplace=True), nn.Linear(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# ============================================================\n# 2. Data Loading\n# ============================================================\nRESULTS_PATH = '/kaggle/input/datasets/altafurrahmanfuad/clean-resume-checkpoints/results'\nAUG_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-dataset-augmented/CCMT Dataset-Augmented'\nRAW_BASE_PATH = '/kaggle/input/datasets/altafurrahmanfuad/ccmt-raw/Raw Data/CCMT Dataset'\n\nMODEL_A_PATH = f'{RESULTS_PATH}/model_A_raw_best.pth'\nMODEL_B_PATH = f'{RESULTS_PATH}/model_B_leaked_best.pth'\nMODEL_CLEAN_PATH = '/kaggle/working/model_clean_best.pth' \n\nwith open(f'{RESULTS_PATH}/raw_clean_split.json') as f: raw_data = json.load(f)\nclass_to_idx = raw_data['class_to_idx']\nctd = raw_data['class_to_domain']\nclass_to_domain = {class_to_idx[name]: int(dom) for name, dom in ctd.items()} if all(isinstance(k, str) and not k.isdigit() for k in ctd.keys()) else {int(k): int(v) for k, v in ctd.items()}\nDIS_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 0]\nPEST_CLASSES = [g for g in range(len(class_to_idx)) if class_to_domain[g] == 1]\nglobal_to_dis = {g: i for i, g in enumerate(DIS_CLASSES)}\nglobal_to_pest = {g: i for i, g in enumerate(PEST_CLASSES)}\n\nval_tf = transforms.Compose([\n    transforms.Resize((224, 224)), transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\nclass CCMTDataset(Dataset):\n    def __init__(self, data_list, transform=None, is_raw=False):\n        self.data = data_list; self.transform = transform; self.is_raw = is_raw\n    def __len__(self): return len(self.data)\n    def __getitem__(self, idx):\n        path, global_lbl, dom = self.data[idx]\n        if path.startswith('/kaggle/input'):\n            if self.is_raw:\n                suffix = path.split('CCMT Dataset/')[-1]\n                path = f'{RAW_BASE_PATH}/{suffix}'\n            else:\n                suffix = path.split('CCMT Dataset-Augmented/')[-1]\n                path = f'{AUG_PATH}/{suffix}'\n        img = Image.open(path).convert('RGB')\n        if self.transform: img = self.transform(img)\n        lbl = global_to_dis[global_lbl] if dom == 0 else global_to_pest[global_lbl]\n        return img, lbl, dom\n\nwith open(f'{RESULTS_PATH}/split_leaked.json') as f: leaked_split = json.load(f)\nwith open(f'{RESULTS_PATH}/split_clean.json') as f: clean_split = json.load(f)\n\nraw_dataset = CCMTDataset(raw_data['test'], val_tf, is_raw=True)\nleaked_dataset = CCMTDataset(leaked_split['test'], val_tf, is_raw=False)\nclean_dataset = CCMTDataset(clean_split['test'], val_tf, is_raw=False)\n\nraw_loader = DataLoader(raw_dataset, batch_size=16, shuffle=False, num_workers=2)\nleaked_loader = DataLoader(leaked_dataset, batch_size=16, shuffle=False, num_workers=2)\nclean_loader = DataLoader(clean_dataset, batch_size=16, shuffle=False, num_workers=2)\n\n# ============================================================\n# 3. Evaluation & Saving Function\n# ============================================================\ndef evaluate_and_save(model, loader, model_name):\n    model.eval()\n    all_preds_d, all_labels_d, all_probs_d = [], [], []\n    all_preds_p, all_labels_p, all_probs_p = [], [], []\n    \n    with torch.no_grad():\n        for imgs, labels, domains in tqdm(loader, desc=f\"Evaluating {model_name}\"):\n            imgs, labels, domains = imgs.to(device), labels.to(device), domains.to(device)\n            ld, lp = model(imgs, domains)\n            dm = (domains == 0); pm = (domains == 1)\n            if dm.any():\n                probs = F.softmax(ld[dm], dim=1)\n                all_probs_d.extend(probs.cpu().numpy()); all_preds_d.extend(probs.argmax(1).cpu().numpy()); all_labels_d.extend(labels[dm].cpu().numpy())\n            if pm.any():\n                probs = F.softmax(lp[pm], dim=1)\n                all_probs_p.extend(probs.cpu().numpy()); all_preds_p.extend(probs.argmax(1).cpu().numpy()); all_labels_p.extend(labels[pm].cpu().numpy())\n\n    print(f\"\\n{'='*60}\\n 📊 METRICS FOR {model_name}\\n{'='*60}\")\n    print(\"\\n--- Disease Report ---\"); print(classification_report(all_labels_d, all_preds_d, zero_division=0))\n    print(\"\\n--- Pest Report ---\"); print(classification_report(all_labels_p, all_preds_p, zero_division=0))\n\n    safe_name = model_name.replace(' ', '_').replace('(', '').replace(')', '')\n\n    # --- 1. Save Confusion Matrices ---\n    fig, axes = plt.subplots(1, 2, figsize=(20, 8))\n    sns.heatmap(confusion_matrix(all_labels_d, all_preds_d), annot=True, fmt='d', cmap='Blues', ax=axes[0], cbar=False)\n    axes[0].set_title(f'{model_name} - Disease CM'); axes[0].set_xlabel('Predicted'); axes[0].set_ylabel('True')\n    sns.heatmap(confusion_matrix(all_labels_p, all_preds_p), annot=True, fmt='d', cmap='Oranges', ax=axes[1], cbar=False)\n    axes[1].set_title(f'{model_name} - Pest CM'); axes[1].set_xlabel('Predicted'); axes[1].set_ylabel('True')\n    plt.tight_layout()\n    cm_filename = f\"{safe_name}_Confusion_Matrix.png\"\n    plt.savefig(cm_filename, dpi=300, bbox_inches='tight')\n    print(f\"💾 Saved: {cm_filename}\")\n    plt.show()\n\n    # --- 2. Save ROC-AUC Curves ---\n    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n    \n    y_true_d = label_binarize(all_labels_d, classes=range(17))\n    fpr_d, tpr_d, _ = roc_curve(y_true_d.ravel(), np.array(all_probs_d).ravel())\n    axes[0].plot(fpr_d, tpr_d, color='darkorange', lw=2, label=f'AUC = {auc(fpr_d, tpr_d):.3f}')\n    axes[0].plot([0, 1], [0, 1], color='navy', linestyle='--'); axes[0].set_title(f'{model_name} - Disease ROC'); axes[0].legend()\n    \n    y_true_p = label_binarize(all_labels_p, classes=range(5))\n    fpr_p, tpr_p, _ = roc_curve(y_true_p.ravel(), np.array(all_probs_p).ravel())\n    axes[1].plot(fpr_p, tpr_p, color='green', lw=2, label=f'AUC = {auc(fpr_p, tpr_p):.3f}')\n    axes[1].plot([0, 1], [0, 1], color='navy', linestyle='--'); axes[1].set_title(f'{model_name} - Pest ROC'); axes[1].legend()\n    plt.tight_layout()\n    \n    roc_filename = f\"{safe_name}_ROC_Curve.png\"\n    plt.savefig(roc_filename, dpi=300, bbox_inches='tight')\n    print(f\"💾 Saved: {roc_filename}\")\n    plt.show()\n\n# ============================================================\n# 4. Execute for All 3 Models\n# ============================================================\nprint(\"\\n\" + \"=\"*50 + \"\\n 🏆 MODEL-A (RAW)\\n\" + \"=\"*50)\nmodel_a = CrossMambaAgriV2(17, 5).to(device)\nmodel_a.load_state_dict(torch.load(MODEL_A_PATH, map_location=device))\nevaluate_and_save(model_a, raw_loader, \"Model-A (Raw)\")\n\nprint(\"\\n\" + \"=\"*50 + \"\\n 🏆 MODEL-B (LEAKED)\\n\" + \"=\"*50)\nmodel_b = CrossMambaAgriV2(17, 5).to(device)\nmodel_b.load_state_dict(torch.load(MODEL_B_PATH, map_location=device))\nevaluate_and_save(model_b, leaked_loader, \"Model-B (Leaked)\")\n\nprint(\"\\n\" + \"=\"*50 + \"\\n 🏆 MODEL-B+ (CLEAN)\\n\" + \"=\"*50)\nmodel_c = CrossMambaAgriV2(17, 5).to(device)\nmodel_c.load_state_dict(torch.load(MODEL_CLEAN_PATH, map_location=device))\nevaluate_and_save(model_c, clean_loader, \"Model-B+ (Clean)\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nimport numpy as np\nimport math\n\n# ============================================================\n# 📊 DATA SETUP (আমাদের পূর্বের রেজাল্ট থেকে)\n# ============================================================\nmodels = ['Model-A\\n(Raw)', 'Model-B+\\n(Clean)', 'Model-B\\n(Leaked)', 'Karthik et al.\\n(Swin, Leaked)']\noverall_acc = [82.23, 89.20, 93.25, 95.68]\ndisease_acc = [80.67, 87.39, 92.23, 94.50] # Karthik's exact disease acc assumed for radar\npest_acc = [89.34, 97.58, 98.39, 97.50]    # Karthik's exact pest acc assumed for radar\nparams = [38.61, 38.61, 38.61, 88.0]       # Params in Millions\n\n# Colors\ncolors = ['#FF9999', '#99FF99', '#66B2FF', '#FFCC99']\nedge_colors = ['#cc0000', '#008000', '#0000cc', '#cc9900']\n\n# Create a 2x2 Dashboard\nfig, axes = plt.subplots(2, 2, figsize=(18, 14))\nfig.suptitle('CrossMamba-Agri: Comprehensive Performance Dashboard', fontsize=22, fontweight='bold', y=0.98)\n\n# ------------------------------------------------------------\n# 1. Overall Accuracy Bar Chart (Top Left)\n# ------------------------------------------------------------\nbars = axes[0, 0].bar(models, overall_acc, color=colors, edgecolor='black', linewidth=1.2, width=0.6)\nfor bar in bars:\n    yval = bar.get_height()\n    axes[0, 0].text(bar.get_x() + bar.get_width()/2, yval + 0.5, f'{yval:.2f}%', ha='center', va='bottom', fontweight='bold', fontsize=12)\naxes[0, 0].set_title('Overall Accuracy Comparison', fontsize=16, fontweight='bold')\naxes[0, 0].set_ylabel('Accuracy (%)', fontsize=14)\naxes[0, 0].set_ylim(70, 105)\naxes[0, 0].grid(axis='y', linestyle='--', alpha=0.7)\n\n# ------------------------------------------------------------\n# 2. Grouped Bar Chart: Disease vs Pest (Top Right)\n# ------------------------------------------------------------\nx = np.arange(len(models))\nwidth = 0.35\n\nrects1 = axes[0, 1].bar(x - width/2, disease_acc, width, label='Disease', color='#FFB347', edgecolor='black')\nrects2 = axes[0, 1].bar(x + width/2, pest_acc, width, label='Pest', color='#77DD77', edgecolor='black')\n\naxes[0, 1].set_ylabel('Accuracy (%)', fontsize=14)\naxes[0, 1].set_title('Disease vs Pest Accuracy', fontsize=16, fontweight='bold')\naxes[0, 1].set_xticks(x)\naxes[0, 1].set_xticklabels(models, fontsize=11)\naxes[0, 1].legend(loc='lower right', fontsize=12)\naxes[0, 1].set_ylim(70, 105)\naxes[0, 1].grid(axis='y', linestyle='--', alpha=0.7)\n\n# ------------------------------------------------------------\n# 3. Radar Chart (Bottom Left)\n# ------------------------------------------------------------\ncategories = ['Overall Acc', 'Disease Acc', 'Pest Acc', 'Efficiency\\n(Inv. Params)']\nN = len(categories)\n\n# Inverse Parameters (Lower params = Higher efficiency score out of 100)\neff_scores = [100 - (p/100)*10 for p in params] \n\n# Angles for radar chart\nangles = [n / float(N) * 2 * math.pi for n in range(N)]\nangles += angles[:1] # Close the loop\n\nax_radar = fig.add_subplot(2, 2, 3, polar=True)\nax_radar.set_theta_offset(math.pi / 2)\nax_radar.set_t