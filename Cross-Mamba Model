ar(max(ch//2, 4), ch), nn.Sigmoid())\n        self.sig = nn.Sigmoid(); self.norm = nn.BatchNorm2d(ch)\n    @staticmethod\n    def simam(x, e=1e-4):\n        mu = x.mean([2,3], keepdim=True); v = x.var([2,3], keepdim=True, unbiased=False)\n        return 1/(1+torch.exp(-((x-mu)**2/(4*(v+e))+0.5)))\n    def forward(self, x):\n        s = self.sig(self.sc(x)); f = torch.abs(torch.fft.rfft2(x, norm='ortho')).mean([-2,-1])\n        c = self.fm(f).view(x.shape[0], -1, 1, 1)\n        return self.norm(x + x*s*c*self.simam(x))\n\nclass MultiScalePatchEmbed(nn.Module):\n    def __init__(self, in_ch=3, dim=512):\n        super().__init__(); d3 = dim // 3\n        self.patch8 = nn.Conv2d(in_ch, d3, 8, 8); self.patch16 = nn.Conv2d(in_ch, d3, 16, 16); self.patch32 = nn.Conv2d(in_ch, dim - 2*d3, 32, 32)\n        self.proj8 = nn.Linear(d3, dim); self.proj16 = nn.Linear(d3, dim); self.proj32 = nn.Linear(dim - 2*d3, dim); self.fusion = nn.Linear(dim * 3, dim)\n    def forward(self, x):\n        p8 = self.proj8(self.patch8(x).flatten(2).transpose(1, 2)); p16 = self.proj16(self.patch16(x).flatten(2).transpose(1, 2)); p32 = self.proj32(self.patch32(x).flatten(2).transpose(1, 2))\n        p8p = F.adaptive_avg_pool1d(p8.transpose(1,2), 196).transpose(1,2); p32u = F.interpolate(p32.transpose(1,2), size=196, mode='nearest').transpose(1,2)\n        return self.fusion(torch.cat([p8p, p16, p32u], dim=-1))\n\nclass BiMambaBlock(nn.Module):\n    def __init__(self, dim, ds=16, dc=4, e=2):\n        super().__init__(); self.norm = nn.LayerNorm(dim)\n        self.fwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.bwd = Mamba(d_model=dim, d_state=ds, d_conv=dc, expand=e); self.merge = nn.Linear(dim * 2, dim)\n    def forward(self, x):\n        r = x; xn = self.norm(x); f = self.fwd(xn); b = self.bwd(xn.flip(1)).flip(1)\n        return self.merge(torch.cat([f, b], dim=-1)) + r\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim=512, h=8):\n        super().__init__(); self.h = h\n        self.q = nn.Linear(dim, dim); self.k = nn.Linear(dim, dim); self.v = nn.Linear(dim, dim); self.o = nn.Linear(dim, dim)\n    def forward(self, q, kv):\n        B, M, D = q.shape; _, N, _ = kv.shape; hd = D // self.h\n        Q = self.q(q).view(B, M, self.h, hd).transpose(1, 2); K = self.k(kv).view(B, N, self.h, hd).transpose(1, 2); V = self.v(kv).view(B, N, self.h, hd).transpose(1, 2)\n        a = F.softmax(Q @ K.transpose(-2, -1) / (hd ** 0.5), dim=-1)\n        return self.o((a @ V).transpose(1, 2).contiguous().view(B, M, D))\n\nclass AdaptiveQueryGen(nn.Module):\n    def __init__(self, dim, m=12, num_domains=2):\n        super().__init__(); self.m = m; self.base = nn.Parameter(torch.randn(num_domains, m, dim) * 0.02)\n        self.modulator = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, m * dim))\n    def forward(self, global_feat, domain_idx):\n        B = global_feat.shape[0]; base = self.base[domain_idx].unsqueeze(0).expand(B, -1, -1); delta = self.modulator(global_feat).view(B, self.m, -1)\n        return base + delta\n\nclass CrossMambaAgriV2(nn.Module):\n    def __init__(self, dis_cls=17, pest_cls=5, dim=512, depth=8, m_queries=12):\n        super().__init__(); self.dis_classes = dis_cls; self.pest_classes = pest_cls\n        self.bsm = BSM(3); self.patch = MultiScalePatchEmbed(3, dim); self.blocks = nn.ModuleList([BiMambaBlock(dim) for _ in range(depth)]); self.enc_norm = nn.LayerNorm(dim)\n        self.qgen = AdaptiveQueryGen(dim, m=m_queries, num_domains=2); self.ca = CrossAttention(dim, 8)\n        self.mlp_dis = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.mlp_pest = nn.Sequential(nn.Linear(dim, dim), nn.GELU(), nn.LayerNorm(dim), nn.Linear(dim, dim))\n        self.head_dis = nn.Linear(dim, dis_cls); self.head_pest = nn.Linear(dim, pest_cls)\n    def forward(self, x, domain):\n        B = x.shape[0]; x = self.bsm(x); x = self.patch(x)\n        for b in self.blocks: x = b(x)\n        T = self.enc_norm(x); global_feat = T.mean(dim=1); dom_id = int(domain[0].item()); Q = self.qgen(global_feat, dom_id); fused = self.ca(Q, T)\n        if dom_id == 0: feat = self.mlp_dis(fused).mean(1); return torch.clamp(self.head_dis(feat), -20, 20), torch.zeros(B, self.pest_classes, device=x.device)\n        else: feat = self.mlp_pest(fused).mean(1); return torch.zeros(B, self.dis_classes, device=x.device), torch.clamp(self.head_pest(feat), -20, 20)\n\n# --- Load Model ---\nmodel = CrossMambaAgriV2(dis_cls=17, pest_cls=5).to(device)\nmodel.load_state_dict(torch.load('/kaggle/working/model_honest_best.pth'))\nmodel.eval()\n\n# --- Load Data ---\ndf_val = pd.read_csv('/kaggle/working/clean_val.csv')\nval_data = df_val[['path', 'local_label', 'domain']].values.tolist()\n\nbase_tf = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])\n])\n\ndef get_tta_tensors(img_tensor):\n    t1 = img_tensor                                   # Original\n    t2 = torch.flip(img_tensor, dims=[2])             # Horizontal Flip\n    t3 = torch.flip(img_tensor, dims=[1])             # Vertical Flip\n    t4 = torch.flip(img_tensor, dims=[1, 2])          # 180 Rotation\n    return [t1, t2, t3, t4]\n\n# --- TTA Evaluation Loop ---\ny_true_dis, y_pred_dis = [], []\ny_true_pest, y_pred_pest = [], []\n\nprint(\"\\n⏳ Running 4-Way TTA on Validation Set...\")\nfor path, lbl, dom in tqdm(val_data):\n    img = Image.open(path).convert('RGB')\n    base_tensor = base_tf(img)\n    \n    tta_tensors = get_tta_tensors(base_tensor)\n    tta_tensors = [t.unsqueeze(0).to(device) for t in tta_tensors]\n    \n    dom_tensor = torch.tensor([int(dom)]).to(device)\n    \n    probs = []\n    with torch.no_grad():\n        for t in tta_tensors:\n            ld, lp = model(t, dom_tensor)\n            if dom == 0:\n                probs.append(F.softmax(ld, dim=1))\n            else:\n                probs.append(F.softmax(lp, dim=1))\n                \n    avg_prob = torch.mean(torch.stack(probs), dim=0).cpu().numpy()[0]\n    pred = np.argmax(avg_prob)\n    \n    if dom == 0:\n        y_true_dis.append(int(lbl))\n        y_pred_dis.append(pred)\n    else:\n        y_true_pest.append(int(lbl))\n        y_pred_pest.append(pred)\n\n# --- Calculate & Print Results ---\ndef print_tta_metrics(y_true, y_pred, title):\n    acc = 100.0 * sum([1 for t, p in zip(y_true, y_pred) if t == p]) / len(y_true)\n    print(f\"\\n✅ {title} TTA Accuracy: {acc:.2f}%\")\n    \n    print(f\"--- {title} Classification Report ---\")\n    print(classification_report(y_true, y_pred))\n    \n    cm = confusion_matrix(y_true, y_pred)\n    plt.figure(figsize=(10, 8))\n    sns.heatmap(cm, annot=True, fmt='d', cmap='Greens')\n    plt.title(f'{title} Confusion Matrix (With TTA)')\n    plt.ylabel('True Label')\n    plt.xlabel('Predicted Label')\n    plt.show()\n\nprint_tta_metrics(y_true_dis, y_pred_dis, \"Disease\")\nprint_tta_metrics(y_true_pest, y_pred_pest, \"Pest\")\n\noverall_correct = sum([1 for t, p in zip(y_true_dis, y_pred_dis) if t == p]) + sum([1 for t, p in zip(y_true_pest, y_pred_pest) if t == p])\noverall_total = len(y_true_dis) + len(y_true_pest)\nprint(f\"\\n🏆 OVERALL TTA ACCURACY: {100.0 * overall_correct / overall_total:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T01:20:29.867855Z","iopub.execute_input":"2026-11-09T01:20:29.868296Z","iopub.status.idle":"2026-11-09T01:32:06.34723Z","shell.execute_reply.started":"2026-11-09T01:20:29.868269Z","shell.execute_reply":"2026-11-09T01:32:06.34639Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\n\n⏳ Running 4-Way TTA on Validation Set...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 10477/10477 [11:35<00:00, 15.07it/s]\n","output_type":"stream"},{"name":"stdout","text":"\n✅ Disease TTA Accuracy: 93.21%\n--- Disease Classification Report ---\n              pre