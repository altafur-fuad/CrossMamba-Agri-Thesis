 optim.AdamW(model_A.parameters(), lr=STAGE2_LR, weight_decay=0.05)\n\ndef lr_fn(e):\n    if e < WARMUP: return (e + 1) / WARMUP\n    p = (e - WARMUP) / max(1, STAGE2_EPOCHS - WARMUP)\n    return 0.5 * (1 + np.cos(np.pi * p))\n\nscheduler_A = optim.lr_scheduler.LambdaLR(optimizer_A, lr_fn)\n\nprint(f\"\\n{'='*70}\")\nprint(f\"  STAGE 2: Fine-tune ({STAGE2_EPOCHS} epochs, LR={STAGE2_LR})\")\nprint(f\"  Early stopping: patience={PATIENCE}\")\nprint(f\"{'='*70}\\n\")\n\nbest_val_A = 0\nno_improve = 0\n\nfor epoch in range(STAGE2_EPOCHS):\n    start_t = time.time()\n\n    train_loss, train_acc, skipped = train_one_epoch(\n        model_A, raw_train_loader, optimizer_A,\n        crit_dis_A, crit_pest_A, desc=f\"S2-Epoch{epoch+1}\"\n    )\n\n    val_loss, val_acc, dis_acc, pest_acc = evaluate(\n        model_A, raw_val_loader, crit_dis_A, crit_pest_A\n    )\n\n    cur_lr = optimizer_A.param_groups[0]['lr']\n    scheduler_A.step()\n    elapsed = time.time() - start_t\n\n    history_A.append({\n        'stage': 2, 'epoch': epoch + 1,\n        'train_loss': train_loss, 'train_acc': train_acc,\n        'val_loss': val_loss, 'val_acc': val_acc,\n        'dis_acc': dis_acc, 'pest_acc': pest_acc,\n        'lr': cur_lr, 'time_sec': elapsed,\n    })\n\n    print(f\"\\n[S2-Epoch {epoch+1}/{STAGE2_EPOCHS}]  LR={cur_lr:.6f}\")\n    print(f\"  Time         : {elapsed:.0f} sec\")\n    print(f\"  Train Loss   : {train_loss:.4f}  |  Train Acc: {train_acc:.2f}%\")\n    print(f\"  Val Loss     : {val_loss:.4f}  |  Val Acc:   {val_acc:.2f}%\")\n    print(f\"  Disease Acc  : {dis_acc:.2f}%\")\n    print(f\"  Pest Acc     : {pest_acc:.2f}%\")\n\n    torch.save(model_A.state_dict(), '/kaggle/working/model_A_raw.pth')\n    pd.DataFrame(history_A).to_csv('/kaggle/working/history_A.csv', index=False)\n\n    if val_acc > best_val_A + MIN_DELTA:\n        best_val_A = val_acc\n        no_improve = 0\n        torch.save(model_A.state_dict(), '/kaggle/working/model_A_raw_best.pth')\n        print(f\" 